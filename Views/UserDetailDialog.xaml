<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="User Details"
    Height="650" Width="680"
    WindowStartupLocation="CenterOwner"
    Background="#18191D"
    Foreground="#F3F4F6"
    FontFamily="Segoe UI, Segoe UI Variable, Arial"
    FontSize="13">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2D3A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#373B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#373B4D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="tabBorder" Background="#22252F" BorderBrush="#373B4D" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#2A2D3A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#1A1C23"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#373B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header with Avatar & Status -->
            <RowDefinition Height="*"/>    <!-- Tabs with Details -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <Border Grid.Row="0" Background="#22252F" BorderBrush="#373B4D" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="50" Height="50" CornerRadius="25" Background="#0078D4" Margin="0,0,16,0">
                    <TextBlock Text="👤" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Name="TxtHeaderDisplayName" Text="Display Name" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Name="TxtHeaderUPN" Text="user@domain.com" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="2" Name="BorderStatus" Background="#107C41" CornerRadius="12" Padding="12,4" VerticalAlignment="Center">
                    <TextBlock Name="TxtStatusBadge" Text="Active" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="#2A2D3A" BorderBrush="#373B4D" BorderThickness="1" Padding="16">
            <!-- 1. General Info -->
            <TabItem Header="ℹ️ Profile &amp; Organization" Style="{StaticResource ModernTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Username -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,4"/>
                        <TextBlock Name="ValUsername" Grid.Row="0" Grid.Column="1" Text="--" Foreground="#FFFFFF" Margin="0,4"/>

                        <!-- Email -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,4"/>
                        <TextBlock Name="ValEmail" Grid.Row="1" Grid.Column="1" Text="--" Foreground="#FFFFFF" Margin="0,4"/>

                        <!-- Employee ID -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Employee ID / DNI:" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,4"/>
                        <TextBlock Name="ValEmployeeID" Grid.Row="2" Grid.Column="1" Text="--" Foreground="#FFFFFF" Margin="0,4"/>

                        <!-- Title -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Job Title:" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,4"/>
                        <TextBlock Name="ValTitle" Grid.Row="3" Grid.Column="1" Text="--" Foreground="#FFFFFF" Margin="0,4"/>

                        <!-- Department -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Department:" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,4"/>
                        <TextBlock Name="ValDepartment" Grid.Row="4" Grid.Column="1" Text="--" Foreground="#FFFFFF" Margin="0,4"/>

                        <!-- Office -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Office:" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,4"/>
                        <TextBlock Name="ValOffice" Grid.Row="5" Grid.Column="1" Text="--" Foreground="#FFFFFF" Margin="0,4"/>

                        <!-- Company -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Company:" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,4"/>
                        <TextBlock Name="ValCompany" Grid.Row="6" Grid.Column="1" Text="--" Foreground="#FFFFFF" Margin="0,4"/>

                        <!-- Description -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Description:" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,4"/>
                        <TextBlock Name="ValDescription" Grid.Row="7" Grid.Column="1" Text="--" Foreground="#FFFFFF" TextWrapping="Wrap" Margin="0,4"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 2. Security & Dates -->
            <TabItem Header="🔒 Security &amp; Activity" Style="{StaticResource ModernTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Account Status:" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,4"/>
                        <TextBlock Name="ValAccountEnabled" Grid.Row="0" Grid.Column="1" Text="--" Foreground="#FFFFFF" Margin="0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Locked Out:" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,4"/>
                        <TextBlock Name="ValLockedOut" Grid.Row="1" Grid.Column="1" Text="--" Foreground="#FFFFFF" Margin="0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Logon:" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,4"/>
                        <TextBlock Name="ValLastLogon" Grid.Row="2" Grid.Column="1" Text="--" Foreground="#FFFFFF" Margin="0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Password Last Set:" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,4"/>
                        <TextBlock Name="ValPasswordLastSet" Grid.Row="3" Grid.Column="1" Text="--" Foreground="#FFFFFF" Margin="0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Created Date:" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,4"/>
                        <TextBlock Name="ValWhenCreated" Grid.Row="4" Grid.Column="1" Text="--" Foreground="#FFFFFF" Margin="0,4"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Object SID:" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,4"/>
                        <TextBlock Name="ValSID" Grid.Row="5" Grid.Column="1" Text="--" Foreground="#6B7280" FontSize="11" Margin="0,4"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Distinguished Name:" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,4"/>
                        <TextBlock Name="ValDN" Grid.Row="6" Grid.Column="1" Text="--" Foreground="#0078D4" FontSize="11" TextWrapping="Wrap" Margin="0,4"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 3. Group Memberships -->
            <TabItem Header="👥 Groups" Style="{StaticResource ModernTabItem}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="MEMBER OF THE FOLLOWING GROUPS:" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                    <ListBox Name="ListGroups" Grid.Row="1" Style="{StaticResource ModernListBox}" DisplayMemberPath="Name"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Buttons -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Name="BtnClose" Style="{StaticResource ModernButton}">
                <TextBlock Text="Close"/>
            </Button>
        </DockPanel>
    </Grid>
</Window>
