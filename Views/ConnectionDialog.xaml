<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection Profile &amp; Server Settings" Height="580" Width="600"
        MinHeight="460" MinWidth="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BgDark}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Theme Palette Fallbacks -->
        <SolidColorBrush x:Key="BgDark" Color="#0F1015"/>
        <SolidColorBrush x:Key="BgCard" Color="#252936"/>
        <SolidColorBrush x:Key="BgInput" Color="#181A22"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#2F3446"/>
        <SolidColorBrush x:Key="AccentPrimary" Color="#0078D4"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1084D9"/>
        <SolidColorBrush x:Key="AccentActive" Color="#006CBE"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#252936"/>
        <SolidColorBrush x:Key="ButtonHoverBg" Color="#323749"/>
        <SolidColorBrush x:Key="ButtonHoverBorder" Color="#4B526D"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentActive}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Form Fields -->
            <RowDefinition Height="Auto"/> <!-- Diagnostics Result Box -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🌐 Active Directory Connection Profile" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Configure domain controller address, LDAP port, SSL security, and credentials." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Profile Name -->
                <TextBlock Text="Profile Name:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                <TextBox Name="TxtProfileName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14" Text="Production Domain"/>

                <!-- Server / Host -->
                <TextBlock Text="Domain / Server FQDN or IP (leave empty for auto-detect):" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                <TextBox Name="TxtServerHost" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                <!-- Port & SSL -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="LDAP Port (389 / 636 LDAPS / 3268 GC):" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                        <TextBox Name="TxtPort" Style="{StaticResource ModernTextBox}" Text="389"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <CheckBox Name="ChkUseSSL" Content="Use SSL / LDAPS" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <!-- Search Base DN -->
                <TextBlock Text="Search Base DN (optional override, e.g. DC=corp,DC=example,DC=com):" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                <TextBox Name="TxtSearchBase" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                <!-- Credentials -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Authentication" FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,10"/>
                        <CheckBox Name="ChkCurrentCredentials" Content="Use Current Windows Credentials (SSO / Kerberos)" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                        <StackPanel Name="PanelCustomCredentials" Visibility="Collapsed">
                            <TextBlock Text="Username (DOMAIN\user or user@domain):" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBox Name="TxtUsername" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                            <TextBlock Text="Password:" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <PasswordBox Name="TxtPassword" Style="{StaticResource ModernPasswordBox}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Read-Only Profile Mode -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox Name="ChkReadOnlyProfile" Content="🔒 Read-Only Server Profile (Prevent modifications, updates, and deletions)" Foreground="{DynamicResource WarningColor}" FontWeight="SemiBold"/>
                        <TextBlock Text="When enabled, directory write operations (create, modify, move, delete, password resets) are blocked in this profile." FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="22,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Diagnostics Output Card -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Name="TxtDiagStatus" Text="Ready to test connection." FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Name="TxtDiagDetails" Text="Click 'Test Connection' to verify DNS, port connectivity, and RootDSE latency." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Name="BtnTestConnection" Style="{StaticResource ModernButton}" Content="📡 Test Connection" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="BtnCancel" Style="{StaticResource ModernButton}" Content="Cancel" Margin="0,0,8,0"/>
                <Button Name="BtnSaveProfile" Style="{StaticResource PrimaryButton}" Content="Save Profile"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
