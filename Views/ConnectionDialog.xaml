<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection Profile &amp; Server Settings" Height="580" Width="600"
        MinHeight="460" MinWidth="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#181A20" Foreground="#E5E7EB" FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#22252F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#373B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#60A5FA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#22252F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#373B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#60A5FA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2B2F3E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2563EB"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Form Fields -->
            <RowDefinition Height="Auto"/> <!-- Diagnostics Result Box -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🌐 Active Directory Connection Profile" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Configure domain controller address, LDAP port, SSL security, and credentials." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Profile Name -->
                <TextBlock Text="Profile Name:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Name="TxtProfileName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14" Text="Production Domain"/>

                <!-- Server / Host -->
                <TextBlock Text="Domain / Server FQDN or IP (leave empty for auto-detect):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Name="TxtServerHost" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                <!-- Port & SSL -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="LDAP Port (389 / 636 LDAPS / 3268 GC):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Name="TxtPort" Style="{StaticResource ModernTextBox}" Text="389"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <CheckBox Name="ChkUseSSL" Content="Use SSL / LDAPS" Foreground="#E5E7EB" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <!-- Search Base DN -->
                <TextBlock Text="Search Base DN (optional override, e.g. DC=corp,DC=example,DC=com):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Name="TxtSearchBase" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                <!-- Credentials -->
                <Border Background="#1F232E" BorderBrush="#2D313F" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Authentication" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,10"/>
                        <CheckBox Name="ChkCurrentCredentials" Content="Use Current Windows Credentials (SSO / Kerberos)" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                        <StackPanel Name="PanelCustomCredentials" Visibility="Collapsed">
                            <TextBlock Text="Username (DOMAIN\user or user@domain):" Margin="0,0,0,6"/>
                            <TextBox Name="TxtUsername" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                            <TextBlock Text="Password:" Margin="0,0,0,6"/>
                            <PasswordBox Name="TxtPassword" Style="{StaticResource ModernPasswordBox}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Diagnostics Output Card -->
        <Border Grid.Row="2" Background="#161821" BorderBrush="#2D313F" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Name="TxtDiagStatus" Text="Ready to test connection." FontWeight="SemiBold" Foreground="#9CA3AF"/>
                    <TextBlock Name="TxtDiagDetails" Text="Click 'Test Connection' to verify DNS, port connectivity, and RootDSE latency." FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Name="BtnTestConnection" Style="{StaticResource ModernButton}" Content="📡 Test Connection" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="BtnCancel" Style="{StaticResource ModernButton}" Content="Cancel" Margin="0,0,8,0"/>
                <Button Name="BtnSaveProfile" Style="{StaticResource PrimaryButton}" Content="Save Profile"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
