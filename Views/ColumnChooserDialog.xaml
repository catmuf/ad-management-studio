<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Column Chooser - Active Directory Studio" Height="600" Width="560"
        MinHeight="450" MinWidth="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#181A20" Foreground="#E5E7EB" FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#22252F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#373B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#60A5FA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2B2F3E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2563EB"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Search & Filter -->
            <RowDefinition Height="*"/>    <!-- Attributes List -->
            <RowDefinition Height="Auto"/> <!-- Custom Attribute Input -->
            <RowDefinition Height="Auto"/> <!-- Action Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#2D313F" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📊 " FontSize="20"/>
                        <TextBlock Name="TxtDialogTitle" Text="Customize Table Columns" FontSize="18" FontWeight="Bold" Foreground="#60A5FA"/>
                    </StackPanel>
                    <TextBlock Name="TxtDialogSubtitle" Text="Select attributes to display as columns or enter custom AD schema attributes." FontSize="12" Foreground="#9CA3AF" Margin="28,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Name="TxtActiveColumnsCount" Text="0 columns active" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Search & Filter -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
                <TextBox Name="TxtFilterColumns" Style="{StaticResource ModernTextBox}" Height="30" Padding="8,5,26,5" ToolTip="Search attributes by name or description"/>
                <TextBlock Name="TxtFilterPlaceholder" Text="🔍 Quick filter attributes (e.g. mail, phone, SID, date)..." FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,26,0" IsHitTestVisible="False"/>
                <Button Name="BtnClearFilter" Content="✖" Style="{StaticResource ModernButton}" Width="20" Height="20" Padding="0" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" ToolTip="Clear filter"/>
            </Grid>

            <Button Grid.Column="1" Name="BtnSelectAll" Style="{StaticResource ModernButton}" Content="Select All" Height="30" Padding="10,4" Margin="0,0,6,0"/>
            <Button Grid.Column="2" Name="BtnDeselectAll" Style="{StaticResource ModernButton}" Content="Clear All" Height="30" Padding="10,4"/>
        </Grid>

        <!-- Attributes List -->
        <Border Grid.Row="2" Background="#1E222D" BorderBrush="#2D313F" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,12">
            <ListBox Name="LstAttributes" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#292F42"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#253352"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="13"/>
                                    <TextBlock Text="{Binding PropertyKey, StringFormat=' ({0})'}" Foreground="#60A5FA" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#2B2F3E" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#A78BFA" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Custom Attribute Input Box -->
        <Border Grid.Row="3" Background="#1A1D27" BorderBrush="#2D313F" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="➕ Add Custom Schema Attribute" FontSize="12" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Name="TxtCustomAttribute" Style="{StaticResource ModernTextBox}" Height="30" Margin="0,0,8,0" ToolTip="Enter any LDAP schema attribute name (e.g. extensionAttribute1, ipPhone, physicalDeliveryOfficeName)"/>
                    <Button Grid.Column="1" Name="BtnAddCustomAttribute" Style="{StaticResource PrimaryButton}" Height="30" Content="Add Column" Padding="14,4"/>
                </Grid>
                <TextBlock Text="Enter any Active Directory attribute name from schema. It will be queried and added as a column." FontSize="10" Foreground="#6B7280" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Action Footer -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Name="BtnResetDefaults" Style="{StaticResource ModernButton}" Content="🔄 Reset to Defaults" Background="#334155" Padding="12,7" ToolTip="Restore table to standard default columns"/>

            <Button Grid.Column="2" Name="BtnCancel" Style="{StaticResource ModernButton}" Content="Cancel" Margin="0,0,8,0" Padding="14,7"/>
            <Button Grid.Column="3" Name="BtnApply" Style="{StaticResource PrimaryButton}" Content="💾 Apply Columns" Padding="16,7"/>
        </Grid>
    </Grid>
</Window>
