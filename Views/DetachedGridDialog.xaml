<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Detached Analysis Grid (Multi-Monitor View)"
    Height="600" Width="950"
    MinHeight="400" MinWidth="600"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    Background="{DynamicResource BgDark}"
    Foreground="{DynamicResource TextPrimary}"
    FontFamily="Segoe UI, Segoe UI Variable, Arial"
    FontSize="13">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ButtonHoverBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Ribbon -->
        <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍 Filter:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0"/>
                <TextBox Name="TxtDetachedFilter" Grid.Column="1" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Padding="8,4" VerticalAlignment="Center"/>
                <TextBlock Name="TxtDetachedCount" Grid.Column="2" Text="0 items" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="12,0,12,0"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Name="BtnExportCsvDetached" Content="📥 Export CSV" Style="{StaticResource ModernButton}" Margin="0,0,6,0"/>
                    <Button Name="BtnExportHtmlDetached" Content="🌐 Export HTML" Style="{StaticResource ModernButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Cloned DataGrid -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="8">
            <DataGrid Name="GridDetachedData" AutoGenerateColumns="True" IsReadOnly="True" Background="Transparent" BorderThickness="0" RowBackground="{DynamicResource GridRowBg}" AlternatingRowBackground="{DynamicResource GridRowAltBg}" Foreground="{DynamicResource TextPrimary}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"/>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="BtnCloseDetached" Content="Close" Style="{StaticResource ModernButton}" Width="80"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
