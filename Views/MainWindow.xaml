                                <MenuItem Name="CtxGroupCopyLdif" Style="{StaticResource ModernMenuItem}" Header="📜 Copy as LDIF Record"/>
                                <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                <MenuItem Name="CtxGroupAddToBasket" Style="{StaticResource ModernMenuItem}" Header="🛒 Add to Directory Basket"/>
                                <MenuItem Name="CtxGroupInspectAttr" Style="{StaticResource ModernMenuItem}" Header="🏷️ Inspect Raw Attributes"/>
                                <MenuItem Name="CtxGroupCompare" Style="{StaticResource ModernMenuItem}" Header="⚖️ Send to Object Compare"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Group Name" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="SamAccountName" Binding="{Binding SamAccountName}" Width="160"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding GroupScope}" Width="110"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding GroupCategory}" Width="110"/>
                            <DataGridTextColumn Header="OU Location" Binding="{Binding OUPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 4. ORG. UNITS (OUs) PANEL -->
                <Grid Name="PanelOUs" Visibility="Collapsed" Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="180" MaxWidth="500"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: OU Directory Tree -->
                    <Border Grid.Column="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Directory OU Hierarchy" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TreeView Grid.Row="1" Name="TreeOUs" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF">
                                <TreeView.ContextMenu>
                                    <ContextMenu Style="{StaticResource ModernContextMenu}">
                                        <MenuItem Name="CtxOUTreeNewOU" Style="{StaticResource ModernMenuItem}" Header="📁 New Child Organizational Unit..."/>
                                        <MenuItem Name="CtxOUTreeDeleteOU" Style="{StaticResource ModernMenuItem}" Header="🗑️ Delete OU..."/>
                                        <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                        <MenuItem Name="CtxOUTreeCopyDN" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Distinguished Name (DN)" InputGestureText="Ctrl+C"/>
                                        <MenuItem Name="CtxOUTreeInspectAttr" Style="{StaticResource ModernMenuItem}" Header="🏷️ Inspect in Attribute Editor"/>
                                        <MenuItem Name="CtxOUTreeBookmark" Style="{StaticResource ModernMenuItem}" Header="⭐ Bookmark this OU"/>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="Foreground" Value="#E5E7EB"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Padding" Value="2,2"/>
                                        <Style.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0078D4"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1E3A8A"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>
                                        </Style.Resources>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2,2">
                                            <Path Data="M 2,4 C 2,2.9 2.9,2 4,2 L 7.5,2 C 8.3,2 9,2.5 9.4,3.2 L 10.2,4.5 C 10.4,4.8 10.8,5 11.2,5 L 18,5 C 19.1,5 20,5.9 20,7 L 20,16 C 20,17.1 19.1,18 18,18 L 4,18 C 2.9,18 2,17.1 2,16 Z"
                                                  Fill="#FBBF24" Width="15" Height="15" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E5E7EB" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Name="BtnNewOU" Style="{StaticResource PrimaryButton}" Content="➕ New OU" Margin="0,0,6,6"/>
                                <Button Name="BtnDeleteOU" Style="{StaticResource DangerButton}" Content="🗑️ Delete OU" Margin="0,0,6,6"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- GridSplitter between tree and contained objects -->
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#292E3E" Cursor="SizeWE" Margin="2,0"/>

                    <!-- Right: Selected OU Details & Objects -->
                    <Border Grid.Column="2" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- OU Inspector Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Name="TxtSelectedOUName" Text="Select an Organizational Unit" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Name="TxtSelectedOUDN" Text="" FontSize="11" Foreground="#9CA3AF" FontFamily="Consolas" Margin="0,2,0,0"/>
                            </StackPanel>

                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                                    <TextBlock Text="Contained Objects:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Background="#252A3A" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Name="TxtSelectedOUObjectsCount" Text="0 objects" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,6">
                                    <TextBlock Text="Scope:" VerticalAlignment="Center" Foreground="#9CA3AF" Margin="0,0,6,0"/>
                                    <ComboBox Name="CmbOUSearchScope" Style="{StaticResource ModernComboBox}" Width="110" Height="30">
                                        <ComboBoxItem Content="OneLevel" IsSelected="True"/>
                                        <ComboBoxItem Content="Subtree"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button Name="BtnRefreshOUObjects" Style="{StaticResource ModernButton}" Height="30" Content="🔄 Refresh" Margin="0,0,6,6"/>
                                <Button Name="BtnOURawAttributes" Style="{StaticResource ModernButton}" Height="30" Content="🏷️ Raw Attributes" Margin="0,0,6,6"/>
                                <Button Name="BtnOUAddColumn" Style="{StaticResource ModernButton}" Height="30" Content="➕ Add Column" Margin="0,0,6,6" ToolTip="Add attribute column to OU Objects table"/>
                                <Button Name="BtnOUResetColumns" Style="{StaticResource ModernButton}" Height="30" Content="🔄 Reset Columns" Margin="0,0,6,6" ToolTip="Reset OU Objects table columns to default"/>
                            </WrapPanel>

                            <!-- Contained Objects DataGrid with ContextMenu -->
                            <DataGrid Grid.Row="2" Name="GridOUObjects" Style="{StaticResource ModernDataGrid}">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Style="{StaticResource ModernContextMenu}">
                                        <MenuItem Name="CtxOUObjInspectAttr" Style="{StaticResource ModernMenuItem}" Header="🏷️ Inspect Raw Attributes"/>
                                        <MenuItem Name="CtxOUObjAddToBasket" Style="{StaticResource ModernMenuItem}" Header="🛒 Add to Directory Basket"/>
                                        <MenuItem Name="CtxOUObjMoveOU" Style="{StaticResource ModernMenuItem}" Header="📂 Move Object..."/>
                                        <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                        <MenuItem Name="CtxOUObjCopyDN" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Distinguished Name (DN)" InputGestureText="Ctrl+C"/>
                                        <MenuItem Name="CtxOUObjCopyUrl" Style="{StaticResource ModernMenuItem}" Header="🌐 Copy LDAP URL"/>
                                        <MenuItem Name="CtxOUObjCopyLdif" Style="{StaticResource ModernMenuItem}" Header="📜 Copy as LDIF Record"/>
                                        <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                        <MenuItem Name="CtxOUObjCompare" Style="{StaticResource ModernMenuItem}" Header="⚖️ Send to Object Compare"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding ObjectClass}" Width="80"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                                    <DataGridTextColumn Header="SamAccountName" Binding="{Binding SamAccountName}" Width="140"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                    <DataGridTextColumn Header="Distinguished Name" Binding="{Binding DistinguishedName}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 5. COMPUTERS PANEL -->
                <Grid Name="PanelComputers" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal">
                            <Grid Width="280" Margin="0,0,10,6">
                                <TextBox Name="TxtSearchComputers" Style="{StaticResource ModernTextBox}" Height="30" Padding="8,5,26,5" ToolTip="Search computers by Name or Operating System. Live search or press Enter."/>
                                <TextBlock Name="TxtSearchComputersPlaceholder" Text="🔍 Search computers (name, OS...)" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,26,0" IsHitTestVisible="False"/>
                                <Button Name="BtnClearSearchComputers" Content="✖" Style="{StaticResource ModernButton}" Width="20" Height="20" Padding="0" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" ToolTip="Clear search filter"/>
                            </Grid>

                            <Button Name="BtnSearchComputers" Style="{StaticResource PrimaryButton}" Height="30" Content="Search Computers" Margin="0,0,10,6"/>

                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Name="TxtComputersCountBadge" Text="0 computers displayed" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold"/>
                            </Border>
                        </WrapPanel>
                    </Border>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Name="BtnComputerRawAttributes" Style="{StaticResource ModernButton}" Content="🏷️ Raw Attributes" Margin="0,0,6,6"/>
                        <Button Name="BtnComputerCompare" Style="{StaticResource ModernButton}" Content="⚖️ Compare" Margin="0,0,6,6"/>
                        <Button Name="BtnExportComputers" Style="{StaticResource ModernButton}" Content="📤 Export CSV" Margin="0,0,6,6"/>
                        <Button Name="BtnComputerAddToBasket" Style="{StaticResource ModernButton}" Content="🛒 Add to Basket" Margin="0,0,6,6" ToolTip="Add selected computer(s) to Directory Basket"/>
                        <Button Name="BtnComputerAddColumn" Style="{StaticResource ModernButton}" Content="➕ Add Column" Margin="0,0,6,6" ToolTip="Add attribute column to Computers table"/>
                        <Button Name="BtnComputerResetColumns" Style="{StaticResource ModernButton}" Content="🔄 Reset Columns" Margin="0,0,6,6" ToolTip="Reset Computers table columns to default"/>
                    </WrapPanel>

                    <DataGrid Grid.Row="2" Name="GridComputers" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource ModernContextMenu}">
                                <MenuItem Name="CtxCompRdp" Style="{StaticResource ModernMenuItem}" Header="💻 Remote Desktop (mstsc.exe)"/>
                                <MenuItem Name="CtxCompPing" Style="{StaticResource ModernMenuItem}" Header="📡 Ping Host (Test Connectivity)"/>
                                <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                <MenuItem Name="CtxCompCopyDN" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Distinguished Name (DN)" InputGestureText="Ctrl+C"/>
                                <MenuItem Name="CtxCompCopyName" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Computer Name"/>
                                <MenuItem Name="CtxCompCopyLdif" Style="{StaticResource ModernMenuItem}" Header="📜 Copy as LDIF Record"/>
                                <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                <MenuItem Name="CtxCompAddToBasket" Style="{StaticResource ModernMenuItem}" Header="🛒 Add to Directory Basket"/>
                                <MenuItem Name="CtxCompInspectAttr" Style="{StaticResource ModernMenuItem}" Header="🏷️ Inspect Raw Attributes"/>
                                <MenuItem Name="CtxCompCompare" Style="{StaticResource ModernMenuItem}" Header="⚖️ Send to Object Compare"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Computer Name" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="DNS Hostname" Binding="{Binding DNSHostName}" Width="190"/>
                            <DataGridTextColumn Header="Operating System" Binding="{Binding OperatingSystem}" Width="180"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding OSVersion}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Last Logon" Binding="{Binding LastLogon}" Width="140"/>
                            <DataGridTextColumn Header="OU Location" Binding="{Binding OUPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 6. DIRECTORY SEARCH PANEL (SOFTERRA FILTER BUILDER) -->
                <Grid Name="PanelDirectorySearch" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search Builder Bar -->
                        <RowDefinition Height="Auto"/> <!-- Execution & Export Action Ribbon -->
                        <RowDefinition Height="*"/>    <!-- Results DataGrid -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1: Search Base & Scope & Presets -->
                            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="Search Base (DN):" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <TextBox Name="TxtSearchBaseDn" Style="{StaticResource ModernTextBox}" Width="300" Height="30"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="Scope:" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <ComboBox Name="CmbSearchScope" Style="{StaticResource ModernComboBox}" Width="110" Height="30">
                                        <ComboBoxItem Content="Subtree" IsSelected="True"/>
                                        <ComboBoxItem Content="OneLevel"/>
                                        <ComboBoxItem Content="Base"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="Search Presets:" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <ComboBox Name="CmbSearchPresets" Style="{StaticResource ModernComboBox}" Width="220" Height="30">
                                        <ComboBoxItem Content="Custom Filter..." IsSelected="True"/>
                                        <ComboBoxItem Content="All Users"/>
                                        <ComboBoxItem Content="Locked Out Accounts"/>
                                        <ComboBoxItem Content="Disabled Accounts"/>
                                        <ComboBoxItem Content="Passwords Never Expire"/>
                                        <ComboBoxItem Content="Empty Groups"/>
                                        <ComboBoxItem Content="Privileged Accounts (adminCount=1)"/>
                                        <ComboBoxItem Content="Service Accounts (SPNs)"/>
                                        <ComboBoxItem Content="All Computers"/>
                                        <ComboBoxItem Content="Domain Controllers"/>
                                    </ComboBox>
                                </StackPanel>
                            </WrapPanel>

                            <!-- Row 2: Live Attribute Search & Outcome Display -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <Grid Width="220" Margin="0,0,8,6">
                                    <TextBox Name="TxtSearchAttrFilter" Style="{StaticResource ModernTextBox}" Height="30"/>
                                    <TextBlock Name="TxtSearchAttrPlaceholder" Text="🔍 Quick filter attributes..." FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                </Grid>
                                <Button Name="BtnClearAttrFilter" Style="{StaticResource ModernButton}" Height="30" Padding="10,3" Content="Clear" Margin="0,0,10,6"/>

                                <Border Name="BorderSearchAttrOutcome" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Outcome: " FontSize="11" Foreground="#9CA3AF" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Name="TxtSearchAttrOutcome" Text="Displaying all attributes (type directly in dropdown to search)" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Row 3: Condition Builder & Visual Filter Blocks -->
                            <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                                <ComboBox Name="CmbFilterAttr" Style="{StaticResource ModernComboBox}" Width="200" Height="30" Margin="0,0,8,6"
                                          IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" MaxDropDownHeight="320"
                                          ToolTip="Type here to search attributes in real time, or click arrow to browse all attributes"/>

                                <ComboBox Name="CmbFilterOp" Style="{StaticResource ModernComboBox}" Width="120" Height="30" Margin="0,0,8,6">
                                    <ComboBoxItem Content="=" IsSelected="True"/>
                                    <ComboBoxItem Content="starts with"/>
                                    <ComboBoxItem Content="ends with"/>
                                    <ComboBoxItem Content="contains"/>
                                    <ComboBoxItem Content="* is present"/>
                                    <ComboBoxItem Content="!="/>
                                    <ComboBoxItem Content="&gt;="/>
                                    <ComboBoxItem Content="&lt;="/>
                                </ComboBox>

                                <TextBox Name="TxtFilterVal" Style="{StaticResource ModernTextBox}" Width="180" Height="30" Text="user" Margin="0,0,8,6"/>
                                <Button Name="BtnInsertCondition" Style="{StaticResource ModernButton}" Height="30" Padding="12,3" Content="➕ Add Condition" Margin="0,0,6,6"/>
                                <Button Name="BtnFilterGroupAnd" Style="{StaticResource ModernButton}" Height="30" Padding="12,3" Content="&amp; Group (AND)" Margin="0,0,6,6" ToolTip="Combine with active filter using LDAP AND (&amp;) block"/>
                                <Button Name="BtnFilterGroupOr" Style="{StaticResource ModernButton}" Height="30" Padding="12,3" Content="| Group (OR)" Margin="0,0,6,6" ToolTip="Combine with active filter using LDAP OR (|) block"/>
                                <Button Name="BtnFilterGroupNot" Style="{StaticResource ModernButton}" Height="30" Padding="12,3" Content="! Group (NOT)" Margin="0,0,6,6" ToolTip="Negate current filter using LDAP NOT (!) block"/>
                                <Button Name="BtnFilterClear" Style="{StaticResource ModernButton}" Height="30" Padding="12,3" Content="Clear Filter" Margin="0,0,6,6" ToolTip="Reset filter to (objectClass=*)"/>
                            </WrapPanel>

                            <!-- Row 4: Raw LDAP Filter & Execute -->
                            <Grid Grid.Row="3" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Name="TxtRawLdapFilter" Style="{StaticResource ModernTextBox}" Height="32" FontFamily="Consolas" Text="(objectClass=user)" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Name="BtnRunLdapSearch" Style="{StaticResource PrimaryButton}" Height="32" Width="130" Padding="14,3" Content="🔍 Run Search"/>
                            </Grid>

                            <!-- Row 5: Advanced Regular Expression Filter (Softerra LDAP Administrator 2026 Parity) -->
                            <WrapPanel Grid.Row="4" Orientation="Horizontal">
                                <CheckBox Name="ChkUseRegexFilter" Content="Enable RegEx Filter" VerticalAlignment="Center" Margin="0,0,12,6" Foreground="#E5E7EB" FontWeight="SemiBold"/>

                                <ComboBox Name="CmbRegexTargetAttr" Style="{StaticResource ModernComboBox}" Width="180" Height="30" Margin="0,0,8,6"
                                          IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" MaxDropDownHeight="320"
                                          ToolTip="Type here to search regex target attributes in real time"/>

                                <TextBox Name="TxtRegexPattern" Style="{StaticResource ModernTextBox}" Width="220" Height="30" FontFamily="Consolas" Tag="Regular Expression (e.g. ^adm-.*|\d{3}$)" Margin="0,0,10,6"/>

                                <CheckBox Name="ChkRegexIgnoreCase" Content="Ignore Case" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,6" Foreground="#9CA3AF"/>

                                <CheckBox Name="ChkRegexInvert" Content="Invert Match (Not)" VerticalAlignment="Center" Margin="0,0,12,6" Foreground="#9CA3AF"/>

                                <Border Name="BorderRegexStatus" Background="#1E293B" CornerRadius="3" Padding="8,4" VerticalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Name="TxtRegexStatus" Text="RegEx: Ready" FontSize="11" Foreground="#38BDF8" FontFamily="Consolas"/>
                                </Border>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Execution Stats & Export Ribbon -->
                    <Border Grid.Row="1" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Name="TxtSearchStatus" Text="Ready to execute search." Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,14,6"/>
                            <Button Name="BtnSearchInspectAttr" Style="{StaticResource ModernButton}" Content="🏷️ Inspect Attributes" Margin="0,0,6,6"/>
                            <Button Name="BtnSearchExportCsv" Style="{StaticResource ModernButton}" Content="📤 Export CSV" Margin="0,0,6,6"/>
                            <Button Name="BtnSearchExportLdif" Style="{StaticResource ModernButton}" Content="📜 Export LDIF" Margin="0,0,6,6"/>
                            <Button Name="BtnSearchExportJson" Style="{StaticResource ModernButton}" Content="📋 Export JSON" Margin="0,0,6,6"/>
                            <Button Name="BtnSearchAddToBasket" Style="{StaticResource ModernButton}" Content="🛒 Add to Basket" Margin="0,0,6,6" ToolTip="Add selected search results to Directory Basket"/>
                            <Button Name="BtnSearchAddColumn" Style="{StaticResource ModernButton}" Content="➕ Add Column" Margin="0,0,6,6" ToolTip="Add attribute column to Search Results table"/>
                            <Button Name="BtnSearchResetColumns" Style="{StaticResource ModernButton}" Content="🔄 Reset Columns" Margin="0,0,6,6" ToolTip="Reset Search Results table columns to default"/>
                        </WrapPanel>
                    </Border>

                    <!-- Results DataGrid with ContextMenu -->
                    <DataGrid Grid.Row="2" Name="GridSearchResults" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource ModernContextMenu}">
                                <MenuItem Name="CtxSearchInspectAttr" Style="{StaticResource ModernMenuItem}" Header="🏷️ Inspect Raw Attributes"/>
                                <MenuItem Name="CtxSearchAddToBasket" Style="{StaticResource ModernMenuItem}" Header="🛒 Add to Directory Basket"/>
                                <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                <MenuItem Name="CtxSearchCopyDN" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Distinguished Name (DN)" InputGestureText="Ctrl+C"/>
                                <MenuItem Name="CtxSearchCopySam" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Username / RDN"/>
                                <MenuItem Name="CtxSearchCopyUrl" Style="{StaticResource ModernMenuItem}" Header="🌐 Copy LDAP URL"/>
                                <MenuItem Name="CtxSearchCopyLdif" Style="{StaticResource ModernMenuItem}" Header="📜 Copy as LDIF Record"/>
                                <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                <MenuItem Name="CtxSearchCompare" Style="{StaticResource ModernMenuItem}" Header="⚖️ Send to Object Compare"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Class" Binding="{Binding ObjectClass}" Width="90"/>
                            <DataGridTextColumn Header="SamAccountName" Binding="{Binding SamAccountName}" Width="150"/>
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="180"/>
                            <DataGridTextColumn Header="Distinguished Name" Binding="{Binding DistinguishedName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 7. LDAP-SQL CONSOLE -->
                <Grid Name="PanelLdapSql" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Query Templates & Execute -->
                        <RowDefinition Height="140"/>  <!-- Editor -->
                        <RowDefinition Height="Auto"/> <!-- Stats & Action Ribbon -->
                        <RowDefinition Height="*"/>    <!-- Results -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="SQL Query Template:" VerticalAlignment="Center" Margin="0,0,10,6" Foreground="#9CA3AF"/>
                            <ComboBox Name="CmbSqlTemplates" Style="{StaticResource ModernComboBox}" Width="260" Height="30" Margin="0,0,10,6">
                                <ComboBoxItem Content="Select All Users" IsSelected="True"/>
                                <ComboBoxItem Content="Select Users with Email"/>
                                <ComboBoxItem Content="Select Disabled Accounts"/>
                                <ComboBoxItem Content="Select Computers"/>
                                <ComboBoxItem Content="Select Groups"/>
                            </ComboBox>

                            <Button Name="BtnClearSql" Style="{StaticResource ModernButton}" Height="30" Content="Clear" Margin="0,0,6,6"/>
                            <Button Name="BtnExecuteSql" Style="{StaticResource PrimaryButton}" Height="30" Content="⚡ Execute SQL (F5)" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </Border>

                    <!-- SQL Editor -->
                    <TextBox Grid.Row="1" Name="TxtSqlQuery" Style="{StaticResource ModernTextBox}"
                             FontFamily="Consolas" FontSize="13" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                             Text="SELECT sAMAccountName, displayName, mail, department FROM SUBTREE WHERE objectClass = 'user'"/>

                    <!-- Stats & Ribbon -->
                    <Border Grid.Row="2" Margin="0,0,0,8">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Name="TxtSqlStatus" Text="Ready to execute query." Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,16,6"/>
                            <Button Name="BtnSqlExportCsv" Style="{StaticResource ModernButton}" Content="📤 Export CSV" Margin="0,0,6,6"/>
                            <Button Name="BtnSqlExportJson" Style="{StaticResource ModernButton}" Content="📋 Export JSON" Margin="0,0,6,6"/>
                            <Button Name="BtnSqlExportLdif" Style="{StaticResource ModernButton}" Content="📜 Export LDIF" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </Border>

                    <!-- Tabular Results -->
                    <DataGrid Grid.Row="3" Name="GridSqlResults" Style="{StaticResource ModernDataGrid}"/>
                </Grid>

                <!-- 8. RAW ATTRIBUTE EDITOR (SOFTERRA SIGNATURE) -->
                <Grid Name="PanelAttributeEditor" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Object Selector & Header -->
                        <RowDefinition Height="Auto"/> <!-- Filter & Actions -->
                        <RowDefinition Height="*"/>    <!-- Attributes DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Target Object Selector -->
                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Target Object Distinguished Name (DN) or SamAccountName:" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                <TextBox Name="TxtAttrEditorDN" Style="{StaticResource ModernTextBox}" Height="30" FontFamily="Consolas"/>
                            </StackPanel>

                            <Button Grid.Column="1" Name="BtnLoadRawAttributes" Style="{StaticResource PrimaryButton}" Height="30" Width="140" Content="🏷️ Load Attributes" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>

                    <!-- Filter Bar & Attribute Actions -->
                    <Border Grid.Row="1" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal">
                            <TextBox Name="TxtSearchAttributes" Style="{StaticResource ModernTextBox}" Width="200" Height="30" Margin="0,0,10,6"/>
                            <CheckBox Name="ChkShowOperationalAttributes" Content="Show Operational (+)" IsChecked="False" VerticalAlignment="Center" Margin="0,0,12,6" Foreground="#38BDF8" FontWeight="SemiBold" ToolTip="Query and include operational / directory metadata attributes (e.g. whenCreated, whenChanged, canonicalName, msDS-UserPasswordExpiryTimeComputed)"/>
                            <TextBlock Name="TxtAttrCount" Text="0 attributes loaded" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,14,6"/>
                            <Button Name="BtnEditAttrValue" Style="{StaticResource PrimaryButton}" Content="✏️ Edit Value" Margin="0,0,6,6"/>
                            <Button Name="BtnClearAttrValue" Style="{StaticResource DangerButton}" Content="🗑️ Clear Attribute" Margin="0,0,6,6"/>
                            <Button Name="BtnCopyAttrValue" Style="{StaticResource ModernButton}" Content="📋 Copy Value" Margin="0,0,6,6"/>
                            <Button Name="BtnExportObjectLdif" Style="{StaticResource ModernButton}" Content="📜 Export LDIF" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </Border>

                    <!-- Attributes DataGrid -->
                    <DataGrid Grid.Row="2" Name="GridRawAttributes" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Attribute Name" Binding="{Binding Name}" Width="190"/>
                            <DataGridTextColumn Header="Value (Decoded)" Binding="{Binding Value}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="160"/>
                            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="60"/>
                            <DataGridCheckBoxColumn Header="Operational" Binding="{Binding IsOperational}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 9. OBJECT COMPARE PANEL -->
                <Grid Name="PanelObjectCompare" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Pickers -->
                        <RowDefinition Height="Auto"/> <!-- Summary Badges & Filter -->
                        <RowDefinition Height="*"/>    <!-- Diff Grid -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Object A (Left):" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                <TextBox Name="TxtCompareObjectA" Style="{StaticResource ModernTextBox}" Height="30" FontFamily="Consolas"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="VS" FontWeight="Bold" FontSize="14" Foreground="#60A5FA" VerticalAlignment="Center" Margin="6,16,14,0"/>

                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Object B (Right):" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                <TextBox Name="TxtCompareObjectB" Style="{StaticResource ModernTextBox}" Height="30" FontFamily="Consolas"/>
                            </StackPanel>

                            <Button Grid.Column="3" Name="BtnExecuteCompare" Style="{StaticResource PrimaryButton}" Height="30" Width="140" Content="⚖️ Compare" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>

                    <!-- Summary & Filters -->
                    <Border Grid.Row="1" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Name="TxtCompareSummary" Text="Enter two objects to compare." Foreground="#9CA3AF" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,6"/>
                            <CheckBox Name="ChkCompareDiffsOnly" Content="Show Differences Only" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,6"/>
                            <Button Name="BtnCompareExportCsv" Style="{StaticResource ModernButton}" Content="📤 Export Diff to CSV" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </Border>

                    <!-- Diff DataGrid -->
                    <DataGrid Grid.Row="2" Name="GridCompareResults" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Attribute" Binding="{Binding Attribute}" Width="180"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding DisplayStatus}" Width="120"/>
                            <DataGridTextColumn Header="Object A Value" Binding="{Binding ValueA}" Width="*"/>
                            <DataGridTextColumn Header="Object B Value" Binding="{Binding ValueB}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 10. LDIF STUDIO PANEL -->
                <Grid Name="PanelLdifStudio" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Templates & Buttons -->
                        <RowDefinition Height="*"/>    <!-- Editor -->
                        <RowDefinition Height="Auto"/> <!-- Execution Console Header -->
                        <RowDefinition Height="130"/>  <!-- Execution Console -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="LDIF Template:" VerticalAlignment="Center" Margin="0,0,10,6" Foreground="#9CA3AF"/>
                            <ComboBox Name="CmbLdifTemplates" Style="{StaticResource ModernComboBox}" Width="220" Height="30" Margin="0,0,10,6">
                                <ComboBoxItem Content="Template: Modify Attribute" IsSelected="True"/>
                                <ComboBoxItem Content="Template: Add New User"/>
                                <ComboBoxItem Content="Template: Delete Object"/>
                            </ComboBox>

                            <Button Name="BtnLdifValidate" Style="{StaticResource ModernButton}" Height="30" Content="🔍 Validate / Dry-Run" Margin="0,0,6,6"/>
                            <Button Name="BtnLdifExecute" Style="{StaticResource PrimaryButton}" Height="30" Content="⚡ Execute LDIF Live" Margin="0,0,6,6"/>
                            <Button Name="BtnLdifExport" Style="{StaticResource ModernButton}" Height="30" Content="💾 Save File" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </Border>

                    <TextBox Grid.Row="1" Name="TxtLdifEditor" Style="{StaticResource ModernTextBox}"
                             FontFamily="Consolas" FontSize="13" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Text="Execution &amp; Transaction Log:" FontWeight="SemiBold" Margin="0,0,0,4"/>

                    <TextBox Grid.Row="3" Name="TxtLdifLog" Style="{StaticResource ModernTextBox}"
                             FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Background="#111319" Foreground="#10B981"/>
                </Grid>

                <!-- 11. SECURITY & AUDIT REPORTS PANEL -->
                <Grid Name="PanelAuditReports" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Audit Selection & Controls -->
                        <RowDefinition Height="Auto"/> <!-- Summary Metrics Cards -->
                        <RowDefinition Height="*"/>    <!-- Findings DataGrid -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="Audit Category:" VerticalAlignment="Center" Margin="0,0,10,6" Foreground="#9CA3AF"/>
                            <ComboBox Name="CmbAuditCategory" Style="{StaticResource ModernComboBox}" Width="220" Height="30" Margin="0,0,12,6">
                                <ComboBoxItem Content="Inactive Users" IsSelected="True"/>
                                <ComboBoxItem Content="Passwords Never Expire"/>
                                <ComboBoxItem Content="Locked Out Accounts"/>
                                <ComboBoxItem Content="Privileged Accounts (Admins)"/>
                                <ComboBoxItem Content="Empty Groups (0 Members)"/>
                                <ComboBoxItem Content="Unprotected OUs"/>
                                <ComboBoxItem Content="Service Accounts (SPNs)"/>
                                <ComboBoxItem Content="Inactive Computers"/>
                            </ComboBox>

                            <TextBlock Text="Days Threshold:" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="#9CA3AF"/>
                            <ComboBox Name="CmbAuditDays" Style="{StaticResource ModernComboBox}" Width="80" Height="30" Margin="0,0,12,6">
                                <ComboBoxItem Content="30"/>
                                <ComboBoxItem Content="60"/>
                                <ComboBoxItem Content="90" IsSelected="True"/>
                                <ComboBoxItem Content="180"/>
                            </ComboBox>

                            <Button Name="BtnRunAudit" Style="{StaticResource PrimaryButton}" Height="30" Content="🛡️ Run Audit" Margin="0,0,12,6"/>
                            <Button Name="BtnExportAuditHtml" Style="{StaticResource ModernButton}" Height="30" Content="📄 HTML Executive Report" Margin="0,0,6,6"/>
                            <Button Name="BtnExportAuditCsv" Style="{StaticResource ModernButton}" Height="30" Content="📤 Export CSV" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </Border>

                    <!-- Audit Metrics Cards -->
                    <Border Grid.Row="1" Background="#1E212D" BorderBrush="#2E3345" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Name="TxtAuditSummary" Text="Select an audit category and click 'Run Audit'." FontWeight="SemiBold" Foreground="#38BDF8"/>
                            <TextBlock Name="TxtAuditCount" Text="" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Grid>
                    </Border>

                    <!-- Findings DataGrid -->
                    <DataGrid Grid.Row="2" Name="GridAuditResults" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account / Object" Binding="{Binding SamAccountName}" Width="150"/>
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="180"/>
                            <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="130"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Detail / Finding" Binding="{Binding DaysInactive}" Width="150"/>
                            <DataGridTextColumn Header="Distinguished Name" Binding="{Binding DistinguishedName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 12. SCHEMA BROWSER PANEL -->
                <Grid Name="PanelSchemaBrowser" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Switcher & Search -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal">
                            <RadioButton Name="RadioSchemaClasses" Style="{StaticResource FilterChip}" Content="Object Classes" IsChecked="True" Margin="0,0,8,6"/>
                            <RadioButton Name="RadioSchemaAttributes" Style="{StaticResource FilterChip}" Content="Attribute Types" Margin="0,0,12,6"/>

                            <TextBox Name="TxtSearchSchema" Style="{StaticResource ModernTextBox}" Width="240" Height="30" Margin="0,0,10,6"/>

                            <Button Name="BtnRefreshSchema" Style="{StaticResource ModernButton}" Height="30" Content="🔄 Load Schema" Margin="0,0,6,6"/>
                            <Button Name="BtnExportSchemaOpenLdap" Style="{StaticResource ModernButton}" Height="30" Content="📤 Export OpenLDAP (.schema)" Margin="0,0,6,6" ToolTip="Export selected schema items to OpenLDAP .schema format"/>
                            <Button Name="BtnExportSchemaLdif" Style="{StaticResource ModernButton}" Height="30" Content="📜 Export Schema LDIF" Margin="0,0,6,6" ToolTip="Export selected schema items to standard schema LDIF format"/>
                        </WrapPanel>
                    </Border>

                    <DataGrid Grid.Row="1" Name="GridSchema" Style="{StaticResource ModernDataGrid}"/>
                </Grid>

                <!-- 13. BULK OPERATIONS PANEL -->
                <Grid Name="PanelBulkEditor" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="👥 Batch Object Operations" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Perform mass operations on multiple directory accounts at once." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,14"/>

                            <WrapPanel Margin="0,0,0,10" Orientation="Horizontal">
                                <ComboBox Name="CmbBulkOperation" Style="{StaticResource ModernComboBox}" Width="180" Height="30" Margin="0,0,8,6">
                                    <ComboBoxItem Content="Set Attribute" IsSelected="True"/>
                                    <ComboBoxItem Content="Enable"/>
                                    <ComboBoxItem Content="Disable"/>
                                    <ComboBoxItem Content="Unlock"/>
                                    <ComboBoxItem Content="RequirePasswordChange"/>
                                    <ComboBoxItem Content="MoveOU"/>
                                </ComboBox>

                                <TextBox Name="TxtBulkAttrName" Style="{StaticResource ModernTextBox}" Width="180" Height="30" Margin="0,0,8,6" Tag="Attribute Name (e.g. department)"/>
                                <TextBox Name="TxtBulkNewValue" Style="{StaticResource ModernTextBox}" Width="200" Height="30" Margin="0,0,8,6" Tag="New Value"/>
                                <Button Name="BtnExecuteBulk" Style="{StaticResource PrimaryButton}" Height="30" Content="⚡ Execute Bulk Operation" Margin="0,0,6,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Log console -->
                    <Border Grid.Row="1" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Batch Execution Log:" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBox Grid.Row="1" Name="TxtBulkLog" Style="{StaticResource ModernTextBox}"
                                     FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Background="#111319" Foreground="#38BDF8"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 14. DIRECTORY BASKET PANEL (SOFTERRA BASKET STAGING & BATCH ENGINE) -->
                <Grid Name="PanelBasket" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header / Summary -->
                        <RowDefinition Height="Auto"/> <!-- Action Ribbon -->
                        <RowDefinition Height="*"/>    <!-- Basket DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Header & Information -->
                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🛒 Directory Basket (Cross-Tree Staging)" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Stage objects from multiple OUs, searches, or categories into a unified workspace for batch operations, cross-container movement, and bulk export." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Staged Objects: " FontSize="12" Foreground="#9CA3AF" FontWeight="Bold"/>
                                    <TextBlock Name="TxtBasketCountBadge" Text="0 objects in basket" FontSize="12" Foreground="#38BDF8" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Action Ribbon -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Name="BtnBasketModifyAttr" Style="{StaticResource PrimaryButton}" Content="✏️ Bulk Edit Attribute" Margin="0,0,6,6" ToolTip="Modify or set an attribute across all staged objects"/>
                        <Button Name="BtnBasketToggleStatus" Style="{StaticResource ModernButton}" Content="⚡ Toggle Status" Margin="0,0,6,6" ToolTip="Toggle enabled/disabled state for staged users"/>
                        <Button Name="BtnBasketMoveOU" Style="{StaticResource ModernButton}" Content="📂 Bulk Move to OU" Margin="0,0,6,6" ToolTip="Move all staged objects to a target Organizational Unit"/>
                        <Button Name="BtnBasketExportCsv" Style="{StaticResource ModernButton}" Content="📤 Export Basket CSV" Margin="0,0,6,6" ToolTip="Export staged objects to CSV"/>
                        <Button Name="BtnBasketExportLdif" Style="{StaticResource ModernButton}" Content="📜 Export Basket LDIF" Margin="0,0,6,6" ToolTip="Export staged objects to LDIF"/>
                        <Button Name="BtnBasketRemoveSelected" Style="{StaticResource ModernButton}" Content="✖ Remove Selected" Margin="0,0,6,6" ToolTip="Remove selected items from basket"/>
                        <Button Name="BtnBasketClear" Style="{StaticResource DangerButton}" Content="🗑️ Clear Basket" Margin="0,0,6,6" ToolTip="Empty all objects from the basket"/>
                    </WrapPanel>

                    <!-- Basket DataGrid with ContextMenu -->
                    <DataGrid Grid.Row="2" Name="GridBasket" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource ModernContextMenu}">
                                <MenuItem Name="CtxBasketInspectAttr" Style="{StaticResource ModernMenuItem}" Header="🏷️ Inspect Raw Attributes"/>
                                <MenuItem Name="CtxBasketCompare" Style="{StaticResource ModernMenuItem}" Header="⚖️ Send to Object Compare"/>
                                <MenuItem Name="CtxBasketRemove" Style="{StaticResource ModernMenuItem}" Header="✖ Remove from Basket"/>
                                <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                <MenuItem Name="CtxBasketCopyDN" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Distinguished Name (DN)" InputGestureText="Ctrl+C"/>
                                <MenuItem Name="CtxBasketCopyLdif" Style="{StaticResource ModernMenuItem}" Header="📜 Copy as LDIF Record"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Class}" Width="90"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="Username / SamAccountName" Binding="{Binding SamAccountName}" Width="160"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="OU Location" Binding="{Binding OUPath}" Width="200"/>
                            <DataGridTextColumn Header="Distinguished Name" Binding="{Binding DistinguishedName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 15. PROTOCOL WIRE REQUEST LOG PANEL (SOFTERRA & APACHE STUDIO REQUEST MONITOR) -->
                <Grid Name="PanelRequestLog" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header / Summary -->
                        <RowDefinition Height="Auto"/> <!-- Controls Ribbon -->
                        <RowDefinition Height="*"/>    <!-- Split: Grid & Detail Viewer -->
                    </Grid.RowDefinitions>

                    <!-- Header & Information -->
                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📡 Live LDAP Protocol Request Log &amp; Wire Inspector" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Real-time capture of all LDAPv3 protocol operations (BIND, SEARCH, MODIFY, ADD, DELETE), query latency, target DNs, and LDIF wire payloads." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Total Wire Requests: " FontSize="12" Foreground="#9CA3AF" FontWeight="Bold"/>
                                    <TextBlock Name="TxtRequestLogCountBadge" Text="0 requests" FontSize="12" Foreground="#10B981" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Controls Ribbon -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Grid Width="240" Margin="0,0,8,6">
                            <TextBox Name="TxtFilterRequestLog" Style="{StaticResource ModernTextBox}" Height="28" Tag="Filter requests (op, DN, status)..."/>
                        </Grid>
                        <Button Name="BtnRequestLogClear" Style="{StaticResource DangerButton}" Content="🗑️ Clear Wire Log" Margin="0,0,6,6"/>
                        <Button Name="BtnRequestLogExport" Style="{StaticResource ModernButton}" Content="📤 Export Log to Text" Margin="0,0,8,6"/>
                        <CheckBox Name="ChkRequestLogAutoScroll" Content="Auto-scroll to latest" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="#E5E7EB"/>
                    </WrapPanel>

                    <!-- Split View: Top DataGrid, Bottom Detail Viewer -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MinHeight="150"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*" MinHeight="100"/>
                        </Grid.RowDefinitions>

                        <!-- Log Entries Grid -->
                        <DataGrid Grid.Row="0" Name="GridRequestLog" Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="95"/>
                                <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="90"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80"/>
                                <DataGridTextColumn Header="Target DN" Binding="{Binding TargetDN}" Width="280"/>
                                <DataGridTextColumn Header="Filter / Payload Details" Binding="{Binding Filter}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Splitter -->
                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#111319" Margin="0,2"/>

                        <!-- Details Viewer -->
                        <Border Grid.Row="2" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="LDAP Protocol Payload &amp; Wire Inspection Details:" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                                <TextBox Grid.Row="1" Name="TxtRequestLogDetails" Style="{StaticResource ModernTextBox}"
                                         FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="#111319" Foreground="#38BDF8"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 16. CONNECTIONS PANEL -->
                <Grid Name="PanelConnections" Visibility="Collapsed" Margin="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🌐 Active Directory Connection Profiles" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Manage domain controller profiles, custom ports, LDAPS SSL, and diagnostic checks." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Name="BtnNewProfile" Style="{StaticResource PrimaryButton}" Content="➕ Add Profile" Margin="0,0,6,6"/>
                                        <Button Name="BtnRunDiagFull" Style="{StaticResource ModernButton}" Content="📡 Test Connection Diagnostics" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <!-- Diagnostics Card & Profile Manager -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Profiles List -->
                                <Border Grid.Column="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,10,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Configured Profiles" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <ListBox Grid.Row="1" Name="ListProfiles" Background="#161820" BorderThickness="1" BorderBrush="#2F3446" Foreground="#FFFFFF" MinHeight="180"/>

                                        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Name="BtnDeleteProfile" Style="{StaticResource DangerButton}" Content="Delete Profile" Margin="0,0,6,6"/>
                                        </WrapPanel>
                                    </Grid>
                                </Border>

                                <!-- Live Diagnostic Results -->
                                <Border Grid.Column="1" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Server Diagnostics &amp; Health Report" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/>

                                        <Border Background="#161820" BorderBrush="#2F3446" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Target Server:" Foreground="#9CA3AF"/>
                                                    <TextBlock Name="TxtDiagServer" Text="--" HorizontalAlignment="Right" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="IP Address:" Foreground="#9CA3AF"/>
                                                    <TextBlock Name="TxtDiagIp" Text="--" HorizontalAlignment="Right" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="LDAP TCP Port (389):" Foreground="#9CA3AF"/>
                                                    <TextBlock Name="TxtDiagPortStatus" Text="--" HorizontalAlignment="Right" Foreground="#107C41" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Round-Trip Latency:" Foreground="#9CA3AF"/>
                                                    <TextBlock Name="TxtDiagLatency" Text="--" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                                                </Grid>
                                                <Grid>
                                                    <TextBlock Text="RootDSE Default NC:" Foreground="#9CA3AF"/>
                                                    <TextBlock Name="TxtDiagDefaultNC" Text="--" HorizontalAlignment="Right" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="11"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Name="TxtDiagMessage" Text="Ready." Foreground="#9CA3AF" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- 15. SETTINGS PANEL -->
                <Grid Name="PanelSettings" Visibility="Collapsed" Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Application Settings &amp; Preferences" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Configure directory defaults, naming conventions, password policies, and CSV exports." FontSize="13" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="8" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                                <TextBlock Text="Active Directory Configuration" FontSize="15" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,12"/>

                                <CheckBox Name="ChkAutoDetect" Content="Auto-detect Active Directory domain and primary controller" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                                <TextBlock Text="Default SearchBase DN (optional override):" Margin="0,0,0,4"/>
                                <TextBox Name="TxtCfgSearchBase" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                                <Separator Background="#252936" Margin="0,10,0,14"/>
                                <TextBlock Text="User Provisioning Defaults" FontSize="15" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,12"/>

                                <TextBlock Text="Default Username Format:" Margin="0,0,0,4"/>
                                <ComboBox Name="CmbUsernameFormat" Style="{StaticResource ModernComboBox}" Margin="0,0,0,12">
                                    <ComboBoxItem Content="first.last (e.g. john.doe)" IsSelected="True"/>
                                    <ComboBoxItem Content="flast (e.g. jdoe)"/>
                                    <ComboBoxItem Content="firstl (e.g. johnd)"/>
                                    <ComboBoxItem Content="lastf (e.g. doej)"/>
                                </ComboBox>

                                <TextBlock Text="Generated Password Length:" Margin="0,0,0,4"/>
                                <TextBox Name="TxtCfgPasswordLength" Style="{StaticResource ModernTextBox}" Text="16" Margin="0,0,0,12"/>

                                <CheckBox Name="ChkCfgRequirePwChange" Content="Require password change at next logon by default" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,0,14"/>

                                <Separator Background="#252936" Margin="0,10,0,14"/>
                                <TextBlock Text="Export Preferences" FontSize="15" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,12"/>

                                <TextBlock Text="CSV Delimiter:" Margin="0,0,0,4"/>
                                <ComboBox Name="CmbExportDelimiter" Style="{StaticResource ModernComboBox}" Margin="0,0,0,16">
                                    <ComboBoxItem Content="; (Semicolon - Recommended for Excel Europe)" IsSelected="True"/>
                                    <ComboBoxItem Content=", (Comma - Standard CSV)"/>
                                </ComboBox>

                                <Button Name="BtnSaveSettings" Style="{StaticResource PrimaryButton}" Content="💾 Save Settings" Width="140" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 16. AD RECYCLE BIN & TOMBSTONE MANAGER (SOFTERRA CH08S14 PARITY) -->
                <Grid Name="PanelRecycleBin" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Actions Ribbon -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="♻️ Active Directory Recycle Bin &amp; Tombstone Manager" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="View and reanimate accidentally deleted Active Directory users, groups, and computers from the CN=Deleted Objects container." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Deleted Objects: " FontSize="12" Foreground="#9CA3AF" FontWeight="Bold"/>
                                    <TextBlock Name="TxtRecycleBinCountBadge" Text="0 objects" FontSize="12" Foreground="#F59E0B" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Actions & Search Bar -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Grid Width="260" Margin="0,0,8,6">
                            <TextBox Name="TxtSearchRecycleBin" Style="{StaticResource ModernTextBox}" Height="30" Padding="8,5,26,5"/>
                            <TextBlock Name="TxtSearchRecycleBinPlaceholder" Text="🔍 Search deleted objects..." FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,26,0" IsHitTestVisible="False"/>
                        </Grid>
                        <Button Name="BtnRefreshRecycleBin" Style="{StaticResource ModernButton}" Height="30" Content="🔄 Refresh" Margin="0,0,6,6"/>
                        <Button Name="BtnQuickRestore" Style="{StaticResource PrimaryButton}" Height="30" Content="⚡ Quick Restore (Original OU)" Margin="0,0,6,6" ToolTip="Restore deleted object back to its last known parent OU"/>
                        <Button Name="BtnRestoreToOU" Style="{StaticResource ModernButton}" Height="30" Content="📂 Restore To Custom OU..." Margin="0,0,6,6" ToolTip="Select a destination Organizational Unit for the restored object"/>
                        <Button Name="BtnRecycleInspectAttr" Style="{StaticResource ModernButton}" Height="30" Content="🏷️ Inspect Attributes" Margin="0,0,6,6"/>
                        <Button Name="BtnExportRecycleBin" Style="{StaticResource ModernButton}" Height="30" Content="📤 Export CSV" Margin="0,0,6,6"/>
                    </WrapPanel>

                    <!-- Deleted Objects DataGrid -->
                    <DataGrid Grid.Row="2" Name="GridRecycleBin" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource ModernContextMenu}">
                                <MenuItem Name="CtxRecycleQuickRestore" Style="{StaticResource ModernMenuItem}" Header="⚡ Quick Restore (Original OU)"/>
                                <MenuItem Name="CtxRecycleRestoreToOU" Style="{StaticResource ModernMenuItem}" Header="📂 Restore To Custom OU..."/>
                                <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                <MenuItem Name="CtxRecycleInspectAttr" Style="{StaticResource ModernMenuItem}" Header="🏷️ Inspect Raw Attributes"/>
                                <MenuItem Name="CtxRecycleCopyDN" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Distinguished Name (DN)" InputGestureText="Ctrl+C"/>
                                <MenuItem Name="CtxRecycleCopyLdif" Style="{StaticResource ModernMenuItem}" Header="📜 Copy as LDIF Record"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Class" Binding="{Binding ObjectClass}" Width="90"/>
                            <DataGridTextColumn Header="Object Name" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="SamAccountName" Binding="{Binding SamAccountName}" Width="150"/>
                            <DataGridTextColumn Header="Deletion Timestamp" Binding="{Binding WhenChanged}" Width="150"/>
                            <DataGridTextColumn Header="Last Known Parent" Binding="{Binding LastKnownParent}" Width="220"/>
                            <DataGridTextColumn Header="Tombstone DN" Binding="{Binding DistinguishedName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 17. SERVER MONITOR & ROOTDSE TELEMETRY (SOFTERRA CH06S04 PARITY) -->
                <Grid Name="PanelServerMonitor" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Telemetry Cards -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🖥️ LDAP Server Monitor &amp; RootDSE Telemetry" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Real-time directory controller capabilities, supported LDAP RFC controls, functional levels, naming contexts, and time skew diagnostics." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Name="BtnRefreshServerMonitor" Style="{StaticResource PrimaryButton}" Height="30" Content="🔄 Refresh Telemetry" Margin="0,0,6,0"/>
                                <Button Name="BtnExportServerMonitor" Style="{StaticResource ModernButton}" Height="30" Content="📤 Export Specs"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,0,8,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Domain Controller & OS Specs -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,12">
                                <StackPanel>
                                    <TextBlock Text="Domain Controller &amp; Functional Level" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Host Name (DNS):" Foreground="#9CA3AF"/>
                                        <TextBlock Name="TxtMonDnsHost" Text="Detecting..." HorizontalAlignment="Right" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="LDAP Service Name:" Foreground="#9CA3AF"/>
                                        <TextBlock Name="TxtMonServiceName" Text="Detecting..." HorizontalAlignment="Right" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Domain Functional Level:" Foreground="#9CA3AF"/>
                                        <TextBlock Name="TxtMonDomainLevel" Text="Detecting..." HorizontalAlignment="Right" Foreground="#10B981" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Forest Functional Level:" Foreground="#9CA3AF"/>
                                        <TextBlock Name="TxtMonForestLevel" Text="Detecting..." HorizontalAlignment="Right" Foreground="#10B981" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Global Catalog Server:" Foreground="#9CA3AF"/>
                                        <TextBlock Name="TxtMonIsGC" Text="Yes (Port 3268/3269)" HorizontalAlignment="Right" Foreground="#FFFFFF"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Clock Skew & Kerberos Time Sync -->
                            <Border Grid.Row="0" Grid.Column="1" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Kerberos Clock Synchronization &amp; Time Skew" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Server Current Time:" Foreground="#9CA3AF"/>
                                        <TextBlock Name="TxtMonServerTime" Text="--" HorizontalAlignment="Right" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Workstation Local Time:" Foreground="#9CA3AF"/>
                                        <TextBlock Name="TxtMonLocalTime" Text="--" HorizontalAlignment="Right" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Calculated Time Skew:" Foreground="#9CA3AF"/>
                                        <TextBlock Name="TxtMonTimeSkew" Text="-- ms" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Kerberos Max Tolerance:" Foreground="#9CA3AF"/>
                                        <TextBlock Text="300 seconds (5 min)" HorizontalAlignment="Right" Foreground="#6B7280"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Directory Partitions & Naming Contexts -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,12">
                                <StackPanel>
                                    <TextBlock Text="Active Directory Naming Contexts" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                    <TextBlock Text="All active directory partitions hosted on this Domain Controller:" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                                    <TextBox Name="TxtMonNamingContexts" Style="{StaticResource ModernTextBox}" Height="120" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Supported Authentication / SASL -->
                            <Border Grid.Row="1" Grid.Column="1" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Supported SASL Authentication Mechanisms" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                    <TextBlock Text="Security binding mechanisms advertised by RootDSE:" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                                    <TextBox Name="TxtMonSaslMechanisms" Style="{StaticResource ModernTextBox}" Height="120" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 5: Supported LDAP Controls (RFC) -->
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Supported LDAP Controls &amp; Capabilities (RFC Standard OIDs)" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                    <TextBlock Text="Directory controls supported by this directory server (Paged Results, Server-Side Sort, Show Deleted, VLV, Permissive Modify):" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                                    <TextBox Name="TxtMonSupportedControls" Style="{StaticResource ModernTextBox}" Height="100" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#0F1015" BorderBrush="#252936" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Name="TxtStatusMessage" Text="Ready: Active Directory Management Studio initialized." FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Name="TxtScopeMessage" Text="Connected to Active Directory" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
