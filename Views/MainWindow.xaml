                                    <MenuItem Name="CtxGroupUseWithDiff" Style="{StaticResource ModernMenuItem}" Header="⚖️ Compare Group Lineage"/>
                                    <MenuItem Name="CtxGroupUseWithResolver" Style="{StaticResource ModernMenuItem}" Header="📝 Send to Resolver Scratchpad"/>
                                    <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                    <MenuItem Name="CtxGroupCopyToDetached" Style="{StaticResource ModernMenuItem}" Header="🗗 Detach Grid to Floating Window"/>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Group Name" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="SamAccountName" Binding="{Binding SamAccountName}" Width="160"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding GroupScope}" Width="110"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding GroupCategory}" Width="110"/>
                            <DataGridTextColumn Header="OU Location" Binding="{Binding OUPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 4. ORG. UNITS (OUs) PANEL -->
                <Grid Name="PanelOUs" Visibility="Collapsed" Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="180" MaxWidth="500"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: OU Directory Tree -->
                    <Border Grid.Column="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Directory OU Hierarchy" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <TextBox Name="TxtFilterOUs" Style="{StaticResource ModernTextBox}" Height="28" Padding="6,4,24,4" ToolTip="Quick filter OU tree nodes in real time"/>
                                <TextBlock Name="TxtFilterOUsPlaceholder" Text="🔍 Filter OUs..." FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="8,0,24,0" IsHitTestVisible="False"/>
                                <Button Name="BtnClearFilterOUs" Content="✖" Style="{StaticResource ModernButton}" Width="18" Height="18" Padding="0" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed" ToolTip="Clear OU filter"/>
                            </Grid>
                            <TreeView Grid.Row="2" Name="TreeOUs" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF">
                                <TreeView.ContextMenu>
                                    <ContextMenu Style="{StaticResource ModernContextMenu}">
                                        <MenuItem Name="CtxOUTreeNewUser" Style="{StaticResource ModernMenuItem}" Header="👤 New User in this OU..."/>
                                        <MenuItem Name="CtxOUTreeNewGroup" Style="{StaticResource ModernMenuItem}" Header="👥 New Group in this OU..."/>
                                        <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                        <MenuItem Name="CtxOUTreeNewOU" Style="{StaticResource ModernMenuItem}" Header="📁 New Child Organizational Unit..."/>
                                        <MenuItem Name="CtxOUTreeRename" Style="{StaticResource ModernMenuItem}" Header="✏️ Rename OU (RDN)..." InputGestureText="F2"/>
                                        <MenuItem Name="CtxOUTreeDeleteOU" Style="{StaticResource ModernMenuItem}" Header="🗑️ Delete OU..."/>
                                        <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                        <MenuItem Name="CtxOUTreeCopyDN" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Distinguished Name (DN)" InputGestureText="Ctrl+C"/>
                                        <MenuItem Name="CtxOUTreeCopyRdn" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Relative DN (RDN)"/>
                                        <MenuItem Name="CtxOUTreeCopyCanonical" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Canonical Name"/>
                                        <MenuItem Name="CtxOUTreeInspectAttr" Style="{StaticResource ModernMenuItem}" Header="🏷️ Inspect in Attribute Editor"/>
                                        <MenuItem Name="CtxOUTreeBookmark" Style="{StaticResource ModernMenuItem}" Header="⭐ Bookmark this OU"/>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="Foreground" Value="#E5E7EB"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Padding" Value="2,2"/>
                                        <Style.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0078D4"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1E3A8A"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>
                                        </Style.Resources>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2,2">
                                            <Path Data="M 2,4 C 2,2.9 2.9,2 4,2 L 7.5,2 C 8.3,2 9,2.5 9.4,3.2 L 10.2,4.5 C 10.4,4.8 10.8,5 11.2,5 L 18,5 C 19.1,5 20,5.9 20,7 L 20,16 C 20,17.1 19.1,18 18,18 L 4,18 C 2.9,18 2,17.1 2,16 Z"
                                                  Fill="#FBBF24" Width="15" Height="15" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E5E7EB" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Name="BtnNewOU" Style="{StaticResource PrimaryButton}" Content="➕ New OU" Margin="0,0,6,6"/>
                                <Button Name="BtnDeleteOU" Style="{StaticResource DangerButton}" Content="🗑️ Delete OU" Margin="0,0,6,6"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- GridSplitter between tree and contained objects -->
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#292E3E" Cursor="SizeWE" Margin="2,0"/>

                    <!-- Right: Selected OU Details & Objects -->
                    <Border Grid.Column="2" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Breadcrumbs Bar -->
                                <RowDefinition Height="Auto"/> <!-- OU Inspector Header -->
                                <RowDefinition Height="Auto"/> <!-- Buttons -->
                                <RowDefinition Height="*"/>    <!-- DataGrid -->
                            </Grid.RowDefinitions>

                            <!-- 0. Breadcrumb Navigation Bar -->
                            <Border Grid.Row="0" Background="#14161F" BorderBrush="#252A3A" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <WrapPanel Name="PanelOUBreadcrumbs" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📍 Path: " FontSize="11" Foreground="#6B7280" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Name="TxtOUBreadcrumbEmpty" Text="(Select an OU to view hierarchy path)" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- OU Inspector Header -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock Name="TxtSelectedOUName" Text="Select an Organizational Unit" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Name="TxtSelectedOUDN" Text="" FontSize="11" Foreground="#9CA3AF" FontFamily="Consolas" Margin="0,2,0,0"/>
                            </StackPanel>

                            <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                                    <TextBlock Text="Contained Objects:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Background="#252A3A" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Name="TxtSelectedOUObjectsCount" Text="0 objects" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,6">
                                    <TextBlock Text="Scope:" VerticalAlignment="Center" Foreground="#9CA3AF" Margin="0,0,6,0"/>
                                    <ComboBox Name="CmbOUSearchScope" Style="{StaticResource ModernComboBox}" Width="110" Height="30">
                                        <ComboBoxItem Content="OneLevel" IsSelected="True"/>
                                        <ComboBoxItem Content="Subtree"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button Name="BtnRefreshOUObjects" Style="{StaticResource ModernButton}" Height="30" Content="🔄 Refresh" Margin="0,0,6,6"/>
                                <Button Name="BtnOURawAttributes" Style="{StaticResource ModernButton}" Height="30" Content="🏷️ Raw Attributes" Margin="0,0,6,6"/>
                                <Button Name="BtnOUAddColumn" Style="{StaticResource ModernButton}" Height="30" Content="➕ Add Column" Margin="0,0,6,6" ToolTip="Add attribute column to OU Objects table"/>
                                <Button Name="BtnOUResetColumns" Style="{StaticResource ModernButton}" Height="30" Content="🔄 Reset Columns" Margin="0,0,6,6" ToolTip="Reset OU Objects table columns to default"/>
                            </WrapPanel>

                            <!-- Contained Objects DataGrid with ContextMenu -->
                            <DataGrid Grid.Row="3" Name="GridOUObjects" Style="{StaticResource ModernDataGrid}">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Style="{StaticResource ModernContextMenu}">
                                        <MenuItem Name="CtxOUObjInspectAttr" Style="{StaticResource ModernMenuItem}" Header="🏷️ Inspect Raw Attributes"/>
                                        <MenuItem Name="CtxOUObjRename" Style="{StaticResource ModernMenuItem}" Header="✏️ Rename Object (RDN)..." InputGestureText="F2"/>
                                        <MenuItem Name="CtxOUObjAddToBasket" Style="{StaticResource ModernMenuItem}" Header="🛒 Add to Directory Basket"/>
                                        <MenuItem Name="CtxOUObjMoveOU" Style="{StaticResource ModernMenuItem}" Header="📂 Move Object..."/>
                                        <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                        <MenuItem Name="CtxOUObjCopyDN" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Distinguished Name (DN)" InputGestureText="Ctrl+C"/>
                                        <MenuItem Name="CtxOUObjCopyRdn" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Relative DN (RDN)"/>
                                        <MenuItem Name="CtxOUObjCopyCanonical" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Canonical Name"/>
                                        <MenuItem Name="CtxOUObjCopyUrl" Style="{StaticResource ModernMenuItem}" Header="🌐 Copy LDAP URL"/>
                                        <MenuItem Name="CtxOUObjCopyLdif" Style="{StaticResource ModernMenuItem}" Header="📜 Copy as LDIF Record"/>
                                        <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                        <MenuItem Name="CtxOUObjCompare" Style="{StaticResource ModernMenuItem}" Header="⚖️ Send to Object Compare"/>
                                        <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                        <MenuItem Name="CtxOUObjViewHtml" Style="{StaticResource ModernMenuItem}" Header="📄 View HTML Dossier (In-App)"/>
                                        <MenuItem Name="CtxOUObjOpenBrowser" Style="{StaticResource ModernMenuItem}" Header="🌐 Open HTML in External Browser"/>
                                        <MenuItem Name="CtxOUObjExternalTools" Style="{StaticResource ModernMenuItem}" Header="🚀 External Tools"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding ObjectClass}" Width="80"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                                    <DataGridTextColumn Header="SamAccountName" Binding="{Binding SamAccountName}" Width="140"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                    <DataGridTextColumn Header="Distinguished Name" Binding="{Binding DistinguishedName}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 5. COMPUTERS PANEL -->
                <Grid Name="PanelComputers" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal">
                            <Grid Width="280" Margin="0,0,10,6">
                                <TextBox Name="TxtSearchComputers" Style="{StaticResource ModernTextBox}" Height="30" Padding="8,5,26,5" ToolTip="Search computers by Name or Operating System. Live search or press Enter."/>
                                <TextBlock Name="TxtSearchComputersPlaceholder" Text="🔍 Search computers (name, OS...)" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,26,0" IsHitTestVisible="False"/>
                                <Button Name="BtnClearSearchComputers" Content="✖" Style="{StaticResource ModernButton}" Width="20" Height="20" Padding="0" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" ToolTip="Clear search filter"/>
                            </Grid>

                            <Button Name="BtnSearchComputers" Style="{StaticResource PrimaryButton}" Height="30" Content="Search Computers" Margin="0,0,10,6"/>

                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Name="TxtComputersCountBadge" Text="0 computers displayed" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold"/>
                            </Border>
                        </WrapPanel>
                    </Border>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Name="BtnComputerRawAttributes" Style="{StaticResource ModernButton}" Content="🏷️ Raw Attributes" Margin="0,0,6,6"/>
                        <Button Name="BtnComputerCompare" Style="{StaticResource ModernButton}" Content="⚖️ Compare" Margin="0,0,6,6"/>
                        <Button Name="BtnExportComputers" Style="{StaticResource ModernButton}" Content="📤 Export CSV" Margin="0,0,6,6"/>
                        <Button Name="BtnComputerAddToBasket" Style="{StaticResource ModernButton}" Content="🛒 Add to Basket" Margin="0,0,6,6" ToolTip="Add selected computer(s) to Directory Basket"/>
                        <Button Name="BtnComputerAddColumn" Style="{StaticResource ModernButton}" Content="➕ Add Column" Margin="0,0,6,6" ToolTip="Add attribute column to Computers table"/>
                        <Button Name="BtnComputerResetColumns" Style="{StaticResource ModernButton}" Content="🔄 Reset Columns" Margin="0,0,6,6" ToolTip="Reset Computers table columns to default"/>
                    </WrapPanel>

                    <DataGrid Grid.Row="2" Name="GridComputers" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource ModernContextMenu}">
                                <MenuItem Name="CtxCompRdp" Style="{StaticResource ModernMenuItem}" Header="💻 Remote Desktop (mstsc.exe)"/>
                                <MenuItem Name="CtxCompPing" Style="{StaticResource ModernMenuItem}" Header="📡 Ping Host (Test Connectivity)"/>
                                <MenuItem Name="CtxCompRename" Style="{StaticResource ModernMenuItem}" Header="✏️ Rename Computer (RDN)..." InputGestureText="F2"/>
                                <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                <MenuItem Name="CtxCompCopyDN" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Distinguished Name (DN)" InputGestureText="Ctrl+C"/>
                                <MenuItem Name="CtxCompCopyRdn" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Relative DN (RDN)"/>
                                <MenuItem Name="CtxCompCopyCanonical" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Canonical Name"/>
                                <MenuItem Name="CtxCompCopyName" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Computer Name"/>
                                <MenuItem Name="CtxCompCopyLdif" Style="{StaticResource ModernMenuItem}" Header="📜 Copy as LDIF Record"/>
                                <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                <MenuItem Name="CtxCompAddToBasket" Style="{StaticResource ModernMenuItem}" Header="🛒 Add to Directory Basket"/>
                                <MenuItem Name="CtxCompInspectAttr" Style="{StaticResource ModernMenuItem}" Header="🏷️ Inspect Raw Attributes"/>
                                <MenuItem Name="CtxCompCompare" Style="{StaticResource ModernMenuItem}" Header="⚖️ Send to Object Compare"/>
                                <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                <MenuItem Name="CtxCompViewHtml" Style="{StaticResource ModernMenuItem}" Header="📄 View HTML Dossier (In-App)"/>
                                <MenuItem Name="CtxCompOpenBrowser" Style="{StaticResource ModernMenuItem}" Header="🌐 Open HTML in External Browser"/>
                                <MenuItem Name="CtxCompExternalTools" Style="{StaticResource ModernMenuItem}" Header="🚀 External Tools"/>
                                <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                <MenuItem Name="CtxCompUseWith" Style="{StaticResource ModernMenuItem}" Header="⚡ Use With (NetTools)...">
                                    <MenuItem Name="CtxCompUseWithAcl" Style="{StaticResource ModernMenuItem}" Header="🛡️ Inspect ACL &amp; Permissions"/>
                                    <MenuItem Name="CtxCompUseWithSpn" Style="{StaticResource ModernMenuItem}" Header="🎟️ Test Host Kerberos SPN Ticket"/>
                                    <MenuItem Name="CtxCompUseWithReplication" Style="{StaticResource ModernMenuItem}" Header="🔄 Check Multi-DC Last Logon / USN"/>
                                    <MenuItem Name="CtxCompUseWithResolver" Style="{StaticResource ModernMenuItem}" Header="📝 Send to Resolver Scratchpad"/>
                                    <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                    <MenuItem Name="CtxCompCopyToDetached" Style="{StaticResource ModernMenuItem}" Header="🗗 Detach Grid to Floating Window"/>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Computer Name" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="DNS Hostname" Binding="{Binding DNSHostName}" Width="190"/>
                            <DataGridTextColumn Header="Operating System" Binding="{Binding OperatingSystem}" Width="180"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding OSVersion}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Last Logon" Binding="{Binding LastLogon}" Width="140"/>
                            <DataGridTextColumn Header="OU Location" Binding="{Binding OUPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 6. DIRECTORY SEARCH PANEL (SOFTERRA FILTER BUILDER) -->
                <Grid Name="PanelDirectorySearch" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search Builder Bar -->
                        <RowDefinition Height="Auto"/> <!-- Execution & Export Action Ribbon -->
                        <RowDefinition Height="*"/>    <!-- Results DataGrid -->
                        <RowDefinition Height="Auto"/> <!-- Results Paging Bar -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1: Search Base & Scope & Presets & History -->
                            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="Search Base (DN):" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <TextBox Name="TxtSearchBaseDn" Style="{StaticResource ModernTextBox}" Width="260" Height="30"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="Scope:" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <ComboBox Name="CmbSearchScope" Style="{StaticResource ModernComboBox}" Width="100" Height="30">
                                        <ComboBoxItem Content="Subtree" IsSelected="True"/>
                                        <ComboBoxItem Content="OneLevel"/>
                                        <ComboBoxItem Content="Base"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="Search Presets:" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <ComboBox Name="CmbSearchPresets" Style="{StaticResource ModernComboBox}" Width="200" Height="30">
                                        <ComboBoxItem Content="Custom Filter..." IsSelected="True"/>
                                        <ComboBoxItem Content="All Users"/>
                                        <ComboBoxItem Content="Locked Out Accounts"/>
                                        <ComboBoxItem Content="Disabled Accounts"/>
                                        <ComboBoxItem Content="Passwords Never Expire"/>
                                        <ComboBoxItem Content="Empty Groups"/>
                                        <ComboBoxItem Content="Privileged Accounts (adminCount=1)"/>
                                        <ComboBoxItem Content="Service Accounts (SPNs)"/>
                                        <ComboBoxItem Content="All Computers"/>
                                        <ComboBoxItem Content="Domain Controllers"/>
                                        <ComboBoxItem Content="Users Created in Last 7 Days"/>
                                        <ComboBoxItem Content="Computers Running Windows Server"/>
                                        <ComboBoxItem Content="Users with Expired Passwords"/>
                                        <ComboBoxItem Content="Accounts with SPN (Kerberoasting Targets)"/>
                                        <ComboBoxItem Content="Groups with No Members"/>
                                        <ComboBoxItem Content="Users Missing Manager Reference"/>
                                        <ComboBoxItem Content="Accounts Requiring Smart Card Logon"/>
                                        <ComboBoxItem Content="Users Whose DisplayName Differs from CN"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="Query History &amp; Pinned:" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox Name="CmbSearchHistory" Style="{StaticResource ModernComboBox}" Width="220" Height="30" ToolTip="Recent and pinned LDAP search queries"/>
                                        <Button Name="BtnPinSearch" Style="{StaticResource ModernButton}" Height="30" Width="36" Content="📌" Margin="4,0,0,0" ToolTip="Pin / Unpin active query"/>
                                    </StackPanel>
                                </StackPanel>
                            </WrapPanel>

                            <!-- Row 2: Live Attribute Search & Outcome Display -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <Grid Width="220" Margin="0,0,8,6">
                                    <TextBox Name="TxtSearchAttrFilter" Style="{StaticResource ModernTextBox}" Height="32"/>
                                    <TextBlock Name="TxtSearchAttrPlaceholder" Text="🔍 Quick filter attributes..." FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                </Grid>
                                <Button Name="BtnClearAttrFilter" Style="{StaticResource ModernButton}" Height="32" Padding="12,4" Content="Clear" Margin="0,0,10,6"/>

                                <Border Name="BorderSearchAttrOutcome" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,5" VerticalAlignment="Center" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Outcome: " FontSize="11" Foreground="#9CA3AF" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Name="TxtSearchAttrOutcome" Text="Displaying all attributes (type directly in dropdown to search)" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Row 3: Condition Builder & Visual Filter Blocks -->
                            <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                                <ComboBox Name="CmbFilterAttr" Style="{StaticResource ModernComboBox}" Width="200" Height="32" Margin="0,0,8,6"
                                          IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" MaxDropDownHeight="320"
                                          ToolTip="Type here to search attributes in real time, or click arrow to browse all attributes"/>

                                <ComboBox Name="CmbFilterOp" Style="{StaticResource ModernComboBox}" Width="120" Height="32" Margin="0,0,8,6">
                                    <ComboBoxItem Content="=" IsSelected="True"/>
                                    <ComboBoxItem Content="starts with"/>
                                    <ComboBoxItem Content="ends with"/>
                                    <ComboBoxItem Content="contains"/>
                                    <ComboBoxItem Content="* is present"/>
                                    <ComboBoxItem Content="!="/>
                                    <ComboBoxItem Content="&gt;="/>
                                    <ComboBoxItem Content="&lt;="/>
                                </ComboBox>

                                <TextBox Name="TxtFilterVal" Style="{StaticResource ModernTextBox}" Width="180" Height="32" Text="user" Margin="0,0,8,6"/>
                                <Button Name="BtnInsertCondition" Style="{StaticResource ModernButton}" Height="32" Padding="12,4" Content="➕ Add Condition" Margin="0,0,6,6"/>
                                <Button Name="BtnFilterGroupAnd" Style="{StaticResource ModernButton}" Height="32" Padding="12,4" Content="&amp; Group (AND)" Margin="0,0,6,6" ToolTip="Combine with active filter using LDAP AND (&amp;) block"/>
                                <Button Name="BtnFilterGroupOr" Style="{StaticResource ModernButton}" Height="32" Padding="12,4" Content="| Group (OR)" Margin="0,0,6,6" ToolTip="Combine with active filter using LDAP OR (|) block"/>
                                <Button Name="BtnFilterGroupNot" Style="{StaticResource ModernButton}" Height="32" Padding="12,4" Content="! Group (NOT)" Margin="0,0,6,6" ToolTip="Negate current filter using LDAP NOT (!) block"/>
                                <Button Name="BtnFilterClear" Style="{StaticResource ModernButton}" Height="32" Padding="12,4" Content="Clear Filter" Margin="0,0,6,6" ToolTip="Reset filter to (objectClass=*)"/>
                            </WrapPanel>

                            <!-- Row 4: Raw LDAP Filter & Execute -->
                            <Grid Grid.Row="3" Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

