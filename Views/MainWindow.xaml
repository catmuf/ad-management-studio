                                <Button Name="BtnCalcEffectivePolicy" Style="{StaticResource ModernButton}" Height="30" Content="🔑 Calculate" Margin="0,0,6,6"/>
                            </WrapPanel>

                            <!-- Row 2: Custom Saved Reports (Softerra Ch06 / Screenshot 10 Parity) -->
                            <Border BorderBrush="#252A3A" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                                <WrapPanel Orientation="Horizontal">
                                    <TextBlock Text="Custom Saved Reports:" VerticalAlignment="Center" Margin="0,0,10,6" Foreground="#FBBF24" FontWeight="SemiBold"/>
                                    <ComboBox Name="CmbCustomReports" Style="{StaticResource ModernComboBox}" Width="220" Height="30" Margin="0,0,8,6"/>
                                    <Button Name="BtnRunCustomReport" Style="{StaticResource ModernButton}" Height="30" Content="▶ Run Report" Margin="0,0,6,6"/>
                                    <Button Name="BtnNewCustomReport" Style="{StaticResource ModernButton}" Height="30" Content="➕ New Custom Report..." Margin="0,0,6,6" ToolTip="Create a custom report definition with custom LDAP filter"/>
                                    <Button Name="BtnDeleteCustomReport" Style="{StaticResource DangerButton}" Height="30" Content="🗑️ Delete Report" Margin="0,0,6,6"/>
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Audit Metrics Cards -->
                    <Border Grid.Row="1" Background="#1E212D" BorderBrush="#2E3345" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Name="TxtAuditSummary" Text="Select an audit category and click 'Run Audit'." FontWeight="SemiBold" Foreground="#38BDF8"/>
                            <TextBlock Name="TxtAuditCount" Text="" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Grid>
                    </Border>

                    <!-- Findings DataGrid -->
                    <DataGrid Grid.Row="2" Name="GridAuditResults" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account / Object" Binding="{Binding SamAccountName}" Width="150"/>
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="180"/>
                            <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="130"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Detail / Finding" Binding="{Binding DaysInactive}" Width="150"/>
                            <DataGridTextColumn Header="Distinguished Name" Binding="{Binding DistinguishedName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 12. SCHEMA BROWSER PANEL -->
                <Grid Name="PanelSchemaBrowser" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Switcher & Search -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal">
                            <RadioButton Name="RadioSchemaClasses" Style="{StaticResource FilterChip}" Content="Object Classes" IsChecked="True" Margin="0,0,8,6"/>
                            <RadioButton Name="RadioSchemaAttributes" Style="{StaticResource FilterChip}" Content="Attribute Types" Margin="0,0,12,6"/>

                            <TextBox Name="TxtSearchSchema" Style="{StaticResource ModernTextBox}" Width="240" Height="30" Margin="0,0,10,6"/>

                            <Button Name="BtnRefreshSchema" Style="{StaticResource ModernButton}" Height="30" Content="🔄 Load Schema" Margin="0,0,6,6"/>
                            <Button Name="BtnExportSchemaOpenLdap" Style="{StaticResource ModernButton}" Height="30" Content="📤 Export OpenLDAP (.schema)" Margin="0,0,6,6" ToolTip="Export selected schema items to OpenLDAP .schema format"/>
                            <Button Name="BtnExportSchemaLdif" Style="{StaticResource ModernButton}" Height="30" Content="📜 Export Schema LDIF" Margin="0,0,6,6" ToolTip="Export selected schema items to standard schema LDIF format"/>
                        </WrapPanel>
                    </Border>

                    <!-- Row 1: 2-Column Schema Catalog and Class Hierarchy Inspector -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="350"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="380" MinWidth="260" MaxWidth="550"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Schema DataGrid -->
                        <DataGrid Grid.Column="0" Name="GridSchema" Style="{StaticResource ModernDataGrid}"/>

                        <!-- Splitter -->
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#292E3E" Cursor="SizeWE"/>

                        <!-- Right: Class Hierarchy & Attribute Inspector -->
                        <Border Grid.Column="2" Background="#161821" BorderBrush="#252A3A" BorderThickness="1" CornerRadius="6" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="🏛️ Schema Class Inspector" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                    <TextBlock Text="Select a class or attribute from the grid to inspect inheritance hierarchy, mandatory and optional attributes." FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <Border Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="CLASS / ATTRIBUTE NAME" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,2"/>
                                            <TextBlock Name="TxtSchemaDetailName" Text="—" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>

                                            <TextBlock Text="OID / GOVERNS ID" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,2"/>
                                            <TextBlock Name="TxtSchemaDetailOID" Text="—" FontSize="11" FontFamily="Consolas" Foreground="#93C5FD" Margin="0,0,0,6"/>

                                            <TextBlock Text="CLASS CATEGORY" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,2"/>
                                            <TextBlock Name="TxtSchemaDetailCategory" Text="—" FontSize="11" Foreground="#34D399" Margin="0,0,0,6"/>

                                            <TextBlock Text="SUBCLASS OF (PARENT)" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,2"/>
                                            <TextBlock Name="TxtSchemaDetailInheritance" Text="—" FontSize="11" Foreground="#F59E0B"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Mandatory (mustContain) Attributes -->
                                    <TextBlock Text="Mandatory Attributes (mustContain)" FontSize="12" FontWeight="SemiBold" Foreground="#EF4444" Margin="0,4,0,4"/>
                                    <Border Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="4" MaxHeight="140" Margin="0,0,0,10">
                                        <ListBox Name="ListSchemaMust" Background="Transparent" BorderThickness="0" Foreground="#E5E7EB" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                    </Border>

                                    <!-- Optional (mayContain) Attributes -->
                                    <TextBlock Text="Optional Attributes (mayContain)" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" Margin="0,0,0,4"/>
                                    <Border Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="4" MaxHeight="180">
                                        <ListBox Name="ListSchemaMay" Background="Transparent" BorderThickness="0" Foreground="#E5E7EB" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 13. BULK OPERATIONS PANEL -->
                <Grid Name="PanelBulkEditor" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="👥 Batch Object Operations" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Perform mass operations on multiple directory accounts at once." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,14"/>

                            <WrapPanel Margin="0,0,0,10" Orientation="Horizontal">
                                <ComboBox Name="CmbBulkOperation" Style="{StaticResource ModernComboBox}" Width="180" Height="30" Margin="0,0,8,6">
                                    <ComboBoxItem Content="Set Attribute" IsSelected="True"/>
                                    <ComboBoxItem Content="Enable"/>
                                    <ComboBoxItem Content="Disable"/>
                                    <ComboBoxItem Content="Unlock"/>
                                    <ComboBoxItem Content="RequirePasswordChange"/>
                                    <ComboBoxItem Content="MoveOU"/>
                                </ComboBox>

                                <TextBox Name="TxtBulkAttrName" Style="{StaticResource ModernTextBox}" Width="180" Height="30" Margin="0,0,8,6" Tag="Attribute Name (e.g. department)"/>
                                <TextBox Name="TxtBulkNewValue" Style="{StaticResource ModernTextBox}" Width="200" Height="30" Margin="0,0,8,6" Tag="New Value"/>
                                <Button Name="BtnExecuteBulk" Style="{StaticResource PrimaryButton}" Height="30" Content="⚡ Execute Bulk Operation" Margin="0,0,6,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Log console -->
                    <Border Grid.Row="1" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Batch Execution Log:" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBox Grid.Row="1" Name="TxtBulkLog" Style="{StaticResource ModernTextBox}"
                                     FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Background="#111319" Foreground="#38BDF8"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 14. DIRECTORY BASKET PANEL (SOFTERRA BASKET STAGING & BATCH ENGINE) -->
                <Grid Name="PanelBasket" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header / Summary -->
                        <RowDefinition Height="Auto"/> <!-- Action Ribbon -->
                        <RowDefinition Height="*"/>    <!-- Basket DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Header & Information -->
                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🛒 Directory Basket (Cross-Tree Staging)" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Stage objects from multiple OUs, searches, or categories into a unified workspace for batch operations, cross-container movement, and bulk export." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Staged Objects: " FontSize="12" Foreground="#9CA3AF" FontWeight="Bold"/>
                                    <TextBlock Name="TxtBasketCountBadge" Text="0 objects in basket" FontSize="12" Foreground="#38BDF8" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Action Ribbon -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Name="BtnBasketModifyAttr" Style="{StaticResource PrimaryButton}" Content="✏️ Bulk Edit Attribute" Margin="0,0,6,6" ToolTip="Modify or set an attribute across all staged objects"/>
                        <Button Name="BtnBasketToggleStatus" Style="{StaticResource ModernButton}" Content="⚡ Toggle Status" Margin="0,0,6,6" ToolTip="Toggle enabled/disabled state for staged users"/>
                        <Button Name="BtnBasketMoveOU" Style="{StaticResource ModernButton}" Content="📂 Bulk Move to OU" Margin="0,0,6,6" ToolTip="Move all staged objects to a target Organizational Unit"/>
                        <Button Name="BtnBasketExportCsv" Style="{StaticResource ModernButton}" Content="📤 Export Basket CSV" Margin="0,0,6,6" ToolTip="Export staged objects to CSV"/>
                        <Button Name="BtnBasketExportLdif" Style="{StaticResource ModernButton}" Content="📜 Export Basket LDIF" Margin="0,0,6,6" ToolTip="Export staged objects to LDIF"/>
                        <Button Name="BtnBasketExportScim" Style="{StaticResource ModernButton}" Content="☁️ Export Basket SCIM 2.0" Margin="0,0,6,6" ToolTip="Export staged objects to RFC 7643 SCIM 2.0 JSON"/>
                        <Button Name="BtnBasketRemoveSelected" Style="{StaticResource ModernButton}" Content="✖ Remove Selected" Margin="0,0,6,6" ToolTip="Remove selected items from basket"/>
                        <Button Name="BtnBasketClear" Style="{StaticResource DangerButton}" Content="🗑️ Clear Basket" Margin="0,0,6,6" ToolTip="Empty all objects from the basket"/>
                    </WrapPanel>

                    <!-- Basket DataGrid with ContextMenu -->
                    <DataGrid Grid.Row="2" Name="GridBasket" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource ModernContextMenu}">
                                <MenuItem Name="CtxBasketInspectAttr" Style="{StaticResource ModernMenuItem}" Header="🏷️ Inspect Raw Attributes"/>
                                <MenuItem Name="CtxBasketCompare" Style="{StaticResource ModernMenuItem}" Header="⚖️ Send to Object Compare"/>
                                <MenuItem Name="CtxBasketRemove" Style="{StaticResource ModernMenuItem}" Header="✖ Remove from Basket"/>
                                <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                <MenuItem Name="CtxBasketCopyDN" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Distinguished Name (DN)" InputGestureText="Ctrl+C"/>
                                <MenuItem Name="CtxBasketCopyLdif" Style="{StaticResource ModernMenuItem}" Header="📜 Copy as LDIF Record"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Class}" Width="90"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="Username / SamAccountName" Binding="{Binding SamAccountName}" Width="160"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="OU Location" Binding="{Binding OUPath}" Width="200"/>
                            <DataGridTextColumn Header="Distinguished Name" Binding="{Binding DistinguishedName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 15. PROTOCOL WIRE REQUEST LOG PANEL (SOFTERRA & APACHE STUDIO REQUEST MONITOR) -->
                <Grid Name="PanelRequestLog" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header / Summary -->
                        <RowDefinition Height="Auto"/> <!-- Controls Ribbon -->
                        <RowDefinition Height="*"/>    <!-- Split: Grid & Detail Viewer -->
                    </Grid.RowDefinitions>

                    <!-- Header & Information -->
                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📡 Live LDAP Protocol Request Log &amp; Wire Inspector" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Real-time capture of all LDAPv3 protocol operations (BIND, SEARCH, MODIFY, ADD, DELETE), query latency, target DNs, and LDIF wire payloads." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Total Wire Requests: " FontSize="12" Foreground="#9CA3AF" FontWeight="Bold"/>
                                    <TextBlock Name="TxtRequestLogCountBadge" Text="0 requests" FontSize="12" Foreground="#10B981" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Controls Ribbon -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Grid Width="240" Margin="0,0,8,6">
                            <TextBox Name="TxtFilterRequestLog" Style="{StaticResource ModernTextBox}" Height="28" Tag="Filter requests (op, DN, status)..."/>
                        </Grid>
                        <Button Name="BtnRequestLogClear" Style="{StaticResource DangerButton}" Content="🗑️ Clear Wire Log" Margin="0,0,6,6"/>
                        <Button Name="BtnRequestLogExport" Style="{StaticResource ModernButton}" Content="📤 Export Log to Text" Margin="0,0,8,6"/>
                        <CheckBox Name="ChkRequestLogAutoScroll" Content="Auto-scroll to latest" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="#E5E7EB"/>
                    </WrapPanel>

                    <!-- Split View: Top DataGrid, Bottom Detail Viewer -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MinHeight="150"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*" MinHeight="100"/>
                        </Grid.RowDefinitions>

                        <!-- Log Entries Grid -->
                        <DataGrid Grid.Row="0" Name="GridRequestLog" Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="95"/>
                                <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="90"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80"/>
                                <DataGridTextColumn Header="Target DN" Binding="{Binding TargetDN}" Width="280"/>
                                <DataGridTextColumn Header="Filter / Payload Details" Binding="{Binding Filter}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Splitter -->
                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#111319" Margin="0,2"/>

                        <!-- Details Viewer -->
                        <Border Grid.Row="2" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="LDAP Protocol Payload &amp; Wire Inspection Details:" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                                <TextBox Grid.Row="1" Name="TxtRequestLogDetails" Style="{StaticResource ModernTextBox}"
                                         FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="#111319" Foreground="#38BDF8"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 16. CONNECTIONS PANEL -->
                <Grid Name="PanelConnections" Visibility="Collapsed" Margin="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🌐 Active Directory Connection Profiles" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Manage domain controller profiles, custom ports, LDAPS SSL, and diagnostic checks." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Name="BtnNewProfile" Style="{StaticResource PrimaryButton}" Content="➕ Add Profile" Margin="0,0,6,6"/>
                                        <Button Name="BtnRunDiagFull" Style="{StaticResource ModernButton}" Content="📡 Test Connection Diagnostics" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <!-- Diagnostics Card & Profile Manager -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Profiles List -->
                                <Border Grid.Column="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,10,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Configured Profiles" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <ListBox Grid.Row="1" Name="ListProfiles" Background="{DynamicResource BgInput}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrushColor}" Foreground="{DynamicResource TextPrimary}" MinHeight="180"/>

                                        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Name="BtnDeleteProfile" Style="{StaticResource DangerButton}" Content="Delete Profile" Margin="0,0,6,6"/>
                                        </WrapPanel>
                                    </Grid>
                                </Border>

                                <!-- Live Diagnostic Results -->
                                <Border Grid.Column="1" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Server Diagnostics &amp; Health Report" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/>

                                        <Border Background="#161820" BorderBrush="#2F3446" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Target Server:" Foreground="#9CA3AF"/>
                                                    <TextBlock Name="TxtDiagServer" Text="--" HorizontalAlignment="Right" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="IP Address:" Foreground="#9CA3AF"/>
                                                    <TextBlock Name="TxtDiagIp" Text="--" HorizontalAlignment="Right" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="LDAP TCP Port (389):" Foreground="#9CA3AF"/>
                                                    <TextBlock Name="TxtDiagPortStatus" Text="--" HorizontalAlignment="Right" Foreground="#107C41" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Round-Trip Latency:" Foreground="#9CA3AF"/>
                                                    <TextBlock Name="TxtDiagLatency" Text="--" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                                                </Grid>
                                                <Grid>
                                                    <TextBlock Text="RootDSE Default NC:" Foreground="#9CA3AF"/>
                                                    <TextBlock Name="TxtDiagDefaultNC" Text="--" HorizontalAlignment="Right" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="11"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Name="TxtDiagMessage" Text="Ready." Foreground="#9CA3AF" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- DNS SRV Auto-Discovery (Softerra Ch06s05 Parity) -->
                            <Border Grid.Row="2" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,14,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🌐 DNS SRV Domain Controller &amp; Service Auto-Discovery" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Discover all Domain Controllers, Kerberos KDCs, and Global Catalogs using DNS SRV records (_ldap, _kerberos, _gc)." FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox Name="TxtDnsDiscoveryDomain" Style="{StaticResource ModernTextBox}" Width="180" Height="30" Margin="0,0,8,0" ToolTip="Domain to query DNS SRV records for"/>
                                            <Button Name="BtnRunDnsDiscovery" Style="{StaticResource PrimaryButton}" Height="30" Content="🔍 Discover Infrastructure" Margin="0,0,8,0"/>
                                            <Button Name="BtnConnectDiscoveredDC" Style="{StaticResource ModernButton}" Height="30" Content="⚡ Connect to Selected DC" ToolTip="Switch active connection profile to selected Domain Controller"/>
                                        </WrapPanel>
                                    </Grid>

                                    <DataGrid Name="GridDnsDiscoveredDCs" Style="{StaticResource ModernDataGrid}" MinHeight="140" MaxHeight="220" AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="170"/>
                                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="160"/>
                                            <DataGridTextColumn Header="Host Name" Binding="{Binding HostName}" Width="190"/>
                                            <DataGridTextColumn Header="IP Address" Binding="{Binding IPAddress}" Width="130"/>
                                            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60"/>
                                            <DataGridTextColumn Header="Latency (ms)" Binding="{Binding LatencyMs}" Width="90"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- 15. SETTINGS PANEL -->
                <Grid Name="PanelSettings" Visibility="Collapsed" Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Application Settings &amp; Preferences" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Configure directory defaults, naming conventions, password policies, and CSV exports." FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                                <TextBlock Text="Active Directory Configuration" FontSize="15" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,12"/>

                                <CheckBox Name="ChkAutoDetect" Content="Auto-detect Active Directory domain and primary controller" IsChecked="True" Margin="0,0,0,10"/>

                                <TextBlock Text="Default SearchBase DN (optional override):" Margin="0,0,0,4"/>
                                <TextBox Name="TxtCfgSearchBase" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                                <Separator Margin="0,10,0,14"/>
                                <TextBlock Text="User Provisioning Defaults" FontSize="15" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,12"/>

                                <TextBlock Text="Default Username Format:" Margin="0,0,0,4"/>
                                <ComboBox Name="CmbUsernameFormat" Style="{StaticResource ModernComboBox}" Margin="0,0,0,12">
                                    <ComboBoxItem Content="first.last (e.g. john.doe)" IsSelected="True"/>
                                    <ComboBoxItem Content="flast (e.g. jdoe)"/>
                                    <ComboBoxItem Content="firstl (e.g. johnd)"/>
                                    <ComboBoxItem Content="lastf (e.g. doej)"/>
                                </ComboBox>

                                <TextBlock Text="Generated Password Length:" Margin="0,0,0,4"/>
                                <TextBox Name="TxtCfgPasswordLength" Style="{StaticResource ModernTextBox}" Text="16" Margin="0,0,0,12"/>

                                <CheckBox Name="ChkCfgRequirePwChange" Content="Require password change at next logon by default" IsChecked="True" Margin="0,0,0,14"/>

                                <Separator Margin="0,10,0,14"/>
                                <TextBlock Text="Export Preferences" FontSize="15" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,12"/>

                                <TextBlock Text="CSV Delimiter:" Margin="0,0,0,4"/>
                                <ComboBox Name="CmbExportDelimiter" Style="{StaticResource ModernComboBox}" Margin="0,0,0,16">
                                    <ComboBoxItem Content="; (Semicolon - Recommended for Excel Europe)" IsSelected="True"/>
                                    <ComboBoxItem Content=", (Comma - Standard CSV)"/>
                                </ComboBox>

                                <Separator Margin="0,10,0,14"/>
                                <TextBlock Text="🎨 Appearance &amp; Visual Theme" FontSize="15" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,12"/>

                                <TextBlock Text="Interface Theme Mode:" Margin="0,0,0,4"/>
                                <ComboBox Name="CmbThemeMode" Style="{StaticResource ModernComboBox}" Margin="0,0,0,12">
                                    <ComboBoxItem Content="🌙 Dark Mode (Slate &amp; Midnight) - Default" IsSelected="True"/>
                                    <ComboBoxItem Content="☀️ Light Mode (Clean Slate &amp; Polar White)"/>
                                </ComboBox>

                                <TextBlock Text="Accent Tone Color:" Margin="0,0,0,4"/>
                                <ComboBox Name="CmbAccentTone" Style="{StaticResource ModernComboBox}" Margin="0,0,0,12">
                                    <ComboBoxItem Content="🔷 Classic Azure Blue (#0078D4)" IsSelected="True"/>
                                    <ComboBoxItem Content="💠 Sky Cyan (#0284C7)"/>
                                    <ComboBoxItem Content="🌿 Emerald Green (#107C41)"/>
                                    <ComboBoxItem Content="🔮 Royal Indigo (#4F46E5)"/>
                                    <ComboBoxItem Content="⚡ Amber Gold (#D97706)"/>
                                </ComboBox>

                                <CheckBox Name="ChkThemeAutoSync" Content="Synchronize in-app HTML View styling with active theme" IsChecked="True" Margin="0,0,0,14"/>

                                <Separator Margin="0,10,0,14"/>
                                <TextBlock Text="🚀 External Tools &amp; Admin Integrations (Softerra Ch22s02)" FontSize="15" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,6"/>
                                <TextBlock Text="Configure external tools and scripts with token replacement (%dNSHostName%, %sAMAccountName%, %distinguishedName%, %mail%)." FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,10"/>

                                <DataGrid Name="GridExternalTools" Style="{StaticResource ModernDataGrid}" Height="160" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tool Name" Binding="{Binding Name}" Width="160"/>
                                        <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="130"/>
                                        <DataGridTextColumn Header="Arguments / Parameters" Binding="{Binding Arguments}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button Name="BtnAddExternalTool" Style="{StaticResource ModernButton}" Content="➕ Add Tool" Margin="0,0,6,6"/>
                                    <Button Name="BtnEditExternalTool" Style="{StaticResource ModernButton}" Content="✏️ Edit Selected" Margin="0,0,6,6"/>
                                    <Button Name="BtnDeleteExternalTool" Style="{StaticResource DangerButton}" Content="🗑️ Delete Tool" Margin="0,0,6,6"/>
                                    <Button Name="BtnResetDefaultTools" Style="{StaticResource ModernButton}" Content="↺ Restore Defaults" Margin="0,0,6,6"/>
                                    <Button Name="BtnTestExternalTool" Style="{StaticResource PrimaryButton}" Content="▶️ Test Run Tool" Margin="0,0,6,6"/>
                                </WrapPanel>

                                <Separator Background="#252936" Margin="0,4,0,14"/>
                                <Button Name="BtnSaveSettings" Style="{StaticResource PrimaryButton}" Content="💾 Save Settings" Width="140" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 16. AD RECYCLE BIN & TOMBSTONE MANAGER (SOFTERRA CH08S14 PARITY) -->
                <Grid Name="PanelRecycleBin" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Actions Ribbon -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="♻️ Active Directory Recycle Bin &amp; Tombstone Manager" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="View and reanimate accidentally deleted Active Directory users, groups, and computers from the CN=Deleted Objects container." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Deleted Objects: " FontSize="12" Foreground="#9CA3AF" FontWeight="Bold"/>
                                    <TextBlock Name="TxtRecycleBinCountBadge" Text="0 objects" FontSize="12" Foreground="#F59E0B" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Actions & Search Bar -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Grid Width="260" Margin="0,0,8,6">
                            <TextBox Name="TxtSearchRecycleBin" Style="{StaticResource ModernTextBox}" Height="30" Padding="8,5,26,5"/>
                            <TextBlock Name="TxtSearchRecycleBinPlaceholder" Text="🔍 Search deleted objects..." FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,26,0" IsHitTestVisible="False"/>
                        </Grid>
                        <Button Name="BtnRefreshRecycleBin" Style="{StaticResource ModernButton}" Height="30" Content="🔄 Refresh" Margin="0,0,6,6"/>
                        <Button Name="BtnQuickRestore" Style="{StaticResource PrimaryButton}" Height="30" Content="⚡ Quick Restore (Original OU)" Margin="0,0,6,6" ToolTip="Restore deleted object back to its last known parent OU"/>
                        <Button Name="BtnRestoreToOU" Style="{StaticResource ModernButton}" Height="30" Content="📂 Restore To Custom OU..." Margin="0,0,6,6" ToolTip="Select a destination Organizational Unit for the restored object"/>
                        <Button Name="BtnRecycleInspectAttr" Style="{StaticResource ModernButton}" Height="30" Content="🏷️ Inspect Attributes" Margin="0,0,6,6"/>
                        <Button Name="BtnExportRecycleBin" Style="{StaticResource ModernButton}" Height="30" Content="📤 Export CSV" Margin="0,0,6,6"/>
                    </WrapPanel>

                    <!-- Deleted Objects DataGrid -->
                    <DataGrid Grid.Row="2" Name="GridRecycleBin" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource ModernContextMenu}">
                                <MenuItem Name="CtxRecycleQuickRestore" Style="{StaticResource ModernMenuItem}" Header="⚡ Quick Restore (Original OU)"/>
                                <MenuItem Name="CtxRecycleRestoreToOU" Style="{StaticResource ModernMenuItem}" Header="📂 Restore To Custom OU..."/>
                                <Separator Style="{StaticResource ModernMenuSeparator}"/>
                                <MenuItem Name="CtxRecycleInspectAttr" Style="{StaticResource ModernMenuItem}" Header="🏷️ Inspect Raw Attributes"/>
                                <MenuItem Name="CtxRecycleCopyDN" Style="{StaticResource ModernMenuItem}" Header="📋 Copy Distinguished Name (DN)" InputGestureText="Ctrl+C"/>
                                <MenuItem Name="CtxRecycleCopyLdif" Style="{StaticResource ModernMenuItem}" Header="📜 Copy as LDIF Record"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Class" Binding="{Binding ObjectClass}" Width="90"/>
                            <DataGridTextColumn Header="Object Name" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="SamAccountName" Binding="{Binding SamAccountName}" Width="150"/>
                            <DataGridTextColumn Header="Deletion Timestamp" Binding="{Binding WhenChanged}" Width="150"/>
                            <DataGridTextColumn Header="Last Known Parent" Binding="{Binding LastKnownParent}" Width="220"/>
                            <DataGridTextColumn Header="Tombstone DN" Binding="{Binding DistinguishedName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 17. SERVER MONITOR & ROOTDSE TELEMETRY (SOFTERRA CH06S04 PARITY) -->
                <Grid Name="PanelServerMonitor" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Telemetry Cards -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🖥️ LDAP Server Monitor &amp; RootDSE Telemetry" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Real-time directory controller capabilities, supported LDAP RFC controls, functional levels, naming contexts, and time skew diagnostics." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Name="BtnRefreshServerMonitor" Style="{StaticResource PrimaryButton}" Height="30" Content="🔄 Refresh Telemetry" Margin="0,0,6,0"/>
                                <Button Name="BtnExportServerMonitor" Style="{StaticResource ModernButton}" Height="30" Content="📤 Export Specs"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,0,8,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Domain Controller & OS Specs -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,12">
                                <StackPanel>
                                    <TextBlock Text="Domain Controller &amp; Functional Level" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Host Name (DNS):" Foreground="#9CA3AF"/>
                                        <TextBlock Name="TxtMonDnsHost" Text="Detecting..." HorizontalAlignment="Right" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="LDAP Service Name:" Foreground="#9CA3AF"/>
                                        <TextBlock Name="TxtMonServiceName" Text="Detecting..." HorizontalAlignment="Right" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Domain Functional Level:" Foreground="#9CA3AF"/>
                                        <TextBlock Name="TxtMonDomainLevel" Text="Detecting..." HorizontalAlignment="Right" Foreground="#10B981" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Forest Functional Level:" Foreground="#9CA3AF"/>
                                        <TextBlock Name="TxtMonForestLevel" Text="Detecting..." HorizontalAlignment="Right" Foreground="#10B981" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Global Catalog Server:" Foreground="#9CA3AF"/>
                                        <TextBlock Name="TxtMonIsGC" Text="Yes (Port 3268/3269)" HorizontalAlignment="Right" Foreground="#FFFFFF"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Clock Skew & Kerberos Time Sync -->
                            <Border Grid.Row="0" Grid.Column="1" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Kerberos Clock Synchronization &amp; Time Skew" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Server Current Time:" Foreground="#9CA3AF"/>
                                        <TextBlock Name="TxtMonServerTime" Text="--" HorizontalAlignment="Right" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Workstation Local Time:" Foreground="#9CA3AF"/>
                                        <TextBlock Name="TxtMonLocalTime" Text="--" HorizontalAlignment="Right" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Calculated Time Skew:" Foreground="#9CA3AF"/>
                                        <TextBlock Name="TxtMonTimeSkew" Text="-- ms" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Kerberos Max Tolerance:" Foreground="#9CA3AF"/>
                                        <TextBlock Text="300 seconds (5 min)" HorizontalAlignment="Right" Foreground="#6B7280"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Directory Partitions & Naming Contexts -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,12">
                                <StackPanel>
                                    <TextBlock Text="Active Directory Naming Contexts" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                    <TextBlock Text="All active directory partitions hosted on this Domain Controller:" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                                    <TextBox Name="TxtMonNamingContexts" Style="{StaticResource ModernTextBox}" Height="120" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Supported Authentication / SASL -->
                            <Border Grid.Row="1" Grid.Column="1" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Supported SASL Authentication Mechanisms" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                    <TextBlock Text="Security binding mechanisms advertised by RootDSE:" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                                    <TextBox Name="TxtMonSaslMechanisms" Style="{StaticResource ModernTextBox}" Height="120" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 5: Supported LDAP Controls (RFC) -->
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Supported LDAP Controls &amp; Capabilities (RFC Standard OIDs)" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                    <TextBlock Text="Directory controls supported by this directory server (Paged Results, Server-Side Sort, Show Deleted, VLV, Permissive Modify):" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                                    <TextBox Name="TxtMonSupportedControls" Style="{StaticResource ModernTextBox}" Height="100" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 6: Active Directory Partitions & Application NCs (Softerra Ch16) -->
                            <Border Grid.Row="3" Grid.ColumnSpan="2" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="🌐 Active Directory Partitions &amp; Application Naming Contexts (NDNC - Softerra Ch16)" FontSize="14" FontWeight="Bold" Foreground="#38BDF8"/>
                                            <TextBlock Text="Non-Domain Naming Contexts (NDNC) and replication partitions (DNS zones, schema, configuration, app partitions):" FontSize="11" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Button Name="BtnRefreshPartitions" Style="{StaticResource ModernButton}" Height="30" Padding="12,4" Content="🔄 Refresh Partitions" Margin="0,0,6,0"/>
                                            <Button Name="BtnNewAppPartition" Style="{StaticResource PrimaryButton}" Height="30" Padding="12,4" Content="➕ New Application Partition"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataGrid Name="GridPartitions" Style="{StaticResource ModernDataGrid}" Height="150">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Partition Name" Binding="{Binding Name}" Width="150"/>
                                            <DataGridTextColumn Header="Partition Type" Binding="{Binding PartitionType}" Width="190"/>
                                            <DataGridTextColumn Header="DNS Root" Binding="{Binding DnsRoot}" Width="160"/>
                                            <DataGridTextColumn Header="Replicas" Binding="{Binding Replicas}" Width="160"/>
                                            <DataGridTextColumn Header="Naming Context DN" Binding="{Binding NamingContextDN}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- 18. HTML DOSSIER VIEW PANEL (SOFTERRA SCREENSHOT 02 PARITY) -->
                <Grid Name="PanelHtmlView" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header & Toolbar -->
                        <RowDefinition Height="*"/>    <!-- WebBrowser -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Title row -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📄 In-App HTML Dossier View" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Render rich, responsive Active Directory object dossiers, organizational cards, and technical reports." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Name="TxtHtmlViewStatusBadge" Text="No Object Loaded" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <!-- Address bar & Actions Toolbar -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Address bar (DN or SamAccountName) -->
                                <Grid Grid.Column="0" Margin="0,0,8,0">
                                    <TextBox Name="TxtHtmlViewDN" Style="{StaticResource ModernTextBox}" Height="30" Padding="8,5" ToolTip="Enter Distinguished Name, SamAccountName, or UPN"/>
                                    <TextBlock Name="TxtHtmlViewDNPlaceholder" Text="Enter DN or sAMAccountName (e.g. jdoe, CN=Administrator,CN=Users,DC=...)" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                </Grid>

                                <Button Grid.Column="1" Name="BtnHtmlViewGo" Style="{StaticResource PrimaryButton}" Height="30" Content="➔ Go" Padding="12,0" Margin="0,0,8,0"/>

                                <!-- Toolbar buttons & Template selector -->
                                <WrapPanel Grid.Column="2" Orientation="Horizontal">
                                    <ComboBox Name="CmbHtmlViewTemplate" Style="{StaticResource ModernComboBox}" Width="170" Height="30" Margin="0,0,6,0" ToolTip="Select HTML Dossier Layout Template">
                                        <ComboBoxItem Content="Full Technical Dossier" IsSelected="True"/>
                                        <ComboBoxItem Content="Executive Summary"/>
                                        <ComboBoxItem Content="Group &amp; Access Audit"/>
                                        <ComboBoxItem Content="Raw Attributes Only"/>
                                    </ComboBox>
                                    <Button Name="BtnHtmlViewRefresh" Style="{StaticResource ModernButton}" Height="30" Content="🔄 Refresh" Margin="0,0,6,0" ToolTip="Reload and re-render current object dossier"/>
                                    <Button Name="BtnHtmlViewPrint" Style="{StaticResource ModernButton}" Height="30" Content="🖨️ Print" Margin="0,0,6,0" ToolTip="Print this dossier"/>
                                    <Button Name="BtnHtmlViewCopyHtml" Style="{StaticResource ModernButton}" Height="30" Content="📋 Copy HTML" Margin="0,0,6,0" ToolTip="Copy raw HTML markup to clipboard"/>
                                    <Button Name="BtnHtmlViewOpenBrowser" Style="{StaticResource ModernButton}" Height="30" Content="🌐 Open in Browser" ToolTip="Open dossier in system web browser"/>
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Embedded WebBrowser Control -->
                    <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
                        <WebBrowser Name="BrowserHtmlView"/>
                    </Border>
                </Grid>

                <!-- 19. ACCESS CONTROL & ACL SUITE (NETTOOLS PARITY) -->
                <Grid Name="PanelSecurityAcl" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🛡️ Access Control &amp; ACL Suite" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Visual DACL/SACL Explorer, Effective Rights Calculator, AdminSDHolder Orphan Auditor &amp; Delegation Matrix." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Name="BtnSecLaunchDialog" Style="{StaticResource PrimaryButton}" Height="30" Content="🔍 Open Full ACL Browser Window..." Padding="12,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TabControl Grid.Row="1">
                        <TabItem Header="🛡️ Visual ACL &amp; Effective Rights">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
