<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Active Directory Management Studio - SysAdmin Edition"
    Height="860" Width="1340"
    MinHeight="680" MinWidth="1050"
    WindowStartupLocation="CenterScreen"
    Background="#14161C"
    Foreground="#F3F4F6"
    FontFamily="Segoe UI, Segoe UI Variable, Arial"
    FontSize="13">

    <Window.Resources>
        <!-- Modern Professional Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#0F1015"/>
        <SolidColorBrush x:Key="BgSidebar" Color="#161820"/>
        <SolidColorBrush x:Key="BgSurface" Color="#1E212B"/>
        <SolidColorBrush x:Key="BgCard" Color="#252936"/>
        <SolidColorBrush x:Key="BgInput" Color="#181A22"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#2F3446"/>
        <SolidColorBrush x:Key="AccentPrimary" Color="#0078D4"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1084D9"/>
        <SolidColorBrush x:Key="AccentActive" Color="#006CBE"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#107C41"/>
        <SolidColorBrush x:Key="DangerColor" Color="#D13438"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="InfoColor" Color="#0EA5E9"/>

        <!-- Standard Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#252936"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2F3446"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#323749"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B526D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E212B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1084D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#006CBE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#3A1C20"/>
            <Setter Property="BorderBrush" Value="#D13438"/>
            <Setter Property="Foreground" Value="#FFA3A8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D13438"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Input TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#181A22"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2F3446"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Dark Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderThickness="0" CornerRadius="3" Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#282D3E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border Name="ToggleBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Path Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="#9CA3AF" Margin="0,1,0,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ToggleBorder" Property="Background" Value="#222634"/>
                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#4B526D"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#0078D4"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#38BDF8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.5"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#6B7280"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern ComboBox (Dark Mode Aero Replacement) -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#181A22"/>
            <Setter Property="BorderBrush" Value="#2F3446"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Focusable="False"
                                          ClickMode="Press"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,2,24,2"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            <TextBox Name="PART_EditableTextBox"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Center"
                                     Margin="8,2,24,2"
                                     Focusable="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="#FFFFFF"
                                     Foreground="{TemplateBinding Foreground}"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Name="DropDownBorder" Background="#181A22"
                                        BorderBrush="#383E54" BorderThickness="1"
                                        CornerRadius="4" Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default ComboBox Style (inherits from ModernComboBox) -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>

        <!-- Nav RadioButton Style (Sidebar Tabs) -->
        <Style x:Key="NavTabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Name="navBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="10,0" Margin="6,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Name="navIndicator" Text="▌" Foreground="Transparent" Margin="0,0,6,0" FontSize="10" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#1E212B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#252936"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="navIndicator" Property="Foreground" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#161820"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2F3446"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#161820"/>
            <Setter Property="AlternatingRowBackground" Value="#1B1E28"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#262A38"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1F232F"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#2F3446"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0078D4"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Filter Chip RadioButton -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Background" Value="#181A22"/>
            <Setter Property="BorderBrush" Value="#2F3446"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Name="chipBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="#252936"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="#0078D4"/>
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#14161C">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>  <!-- Top App Bar / Telemetry -->
            <RowDefinition Height="*"/>   <!-- Main Body: Navigation + Viewport -->
            <RowDefinition Height="30"/>  <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP APP BAR -->
        <Border Grid.Row="0" Background="#111319" BorderBrush="#252936" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Logo & Profiles -->
                    <ColumnDefinition Width="*"/>    <!-- Live Connection Telemetry -->
                    <ColumnDefinition Width="Auto"/> <!-- Quick Actions -->
                </Grid.ColumnDefinitions>

                <!-- Left: Branding & Profile Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Active Directory Studio" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                        <TextBlock Text="SysAdmin LDAP Suite 2026" FontSize="10" Foreground="#60A5FA"/>
                    </StackPanel>

                    <ComboBox Name="CmbActiveProfile" Style="{StaticResource ModernComboBox}" Width="260" Height="28" FontSize="11" Margin="0,0,16,0" ToolTip="Active Directory Connection Profile / Domain Controller">
                        <ComboBoxItem Content="Default (Auto-Detect)" IsSelected="True"/>
                    </ComboBox>
                </StackPanel>

                <!-- Center: Connection Telemetry Badge -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1B1E28" BorderBrush="#2F3446" BorderThickness="1" CornerRadius="16" Padding="14,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Name="StatusDot" Width="8" Height="8" Fill="#107C41" Margin="0,0,8,0"/>
                        <TextBlock Name="TxtDomainBadge" Text="Active Directory" FontSize="12" FontWeight="SemiBold" Foreground="#E5E7EB" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text=" | DC: " FontSize="12" Foreground="#9CA3AF"/>
                        <TextBlock Name="TxtDCBadge" Text="Detecting..." FontSize="12" Foreground="#9CA3AF" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text=" | " FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Name="TxtLatencyBadge" Text="⚡ -- ms" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Right: Diagnostics & Refresh -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="BtnDiagnostics" Style="{StaticResource ModernButton}" Margin="0,0,6,0" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🩺" Margin="0,0,5,0"/>
                            <TextBlock Text="Diagnostics"/>
                        </StackPanel>
                    </Button>

                    <Button Name="BtnGlobalRefresh" Style="{StaticResource ModernButton}" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,5,0"/>
                            <TextBlock Text="Refresh All"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/> <!-- Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Viewport -->
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#13151D" BorderBrush="#252936" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,12">
                        <!-- Group 1: DIRECTORY SERVICES -->
                        <TextBlock Text="DIRECTORY SERVICES" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="14,10,14,4"/>
                        <RadioButton Name="NavDashboard" Style="{StaticResource NavTabButton}" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" Margin="0,0,8,0"/>
                                <TextBlock Text="Dashboard"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Name="NavUsers" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" Margin="0,0,8,0"/>
                                <TextBlock Text="Users"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Name="NavGroups" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡️" Margin="0,0,8,0"/>
                                <TextBlock Text="Groups"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Name="NavOUs" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" Margin="0,0,8,0"/>
                                <TextBlock Text="Org. Units (OUs)"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Name="NavComputers" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💻" Margin="0,0,8,0"/>
                                <TextBlock Text="Computers"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Group 2: SOFTERRA LDAP SUITE -->
                        <Separator Background="#252936" Margin="12,8"/>
                        <TextBlock Text="SOFTERRA LDAP SUITE" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="14,4,14,4"/>

                        <RadioButton Name="NavDirectorySearch" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" Margin="0,0,8,0"/>
                                <TextBlock Text="Directory Search"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Name="NavLdapSql" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" Margin="0,0,8,0"/>
                                <TextBlock Text="LDAP-SQL Console"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Name="NavAttributeEditor" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏷️" Margin="0,0,8,0"/>
                                <TextBlock Text="Raw Attribute Editor"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Name="NavObjectCompare" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚖️" Margin="0,0,8,0"/>
                                <TextBlock Text="Object Compare"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Name="NavLdifStudio" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📜" Margin="0,0,8,0"/>
                                <TextBlock Text="LDIF Studio"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Name="NavAuditReports" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡️" Margin="0,0,8,0"/>
                                <TextBlock Text="Security &amp; Audits"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Name="NavSchemaBrowser" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📚" Margin="0,0,8,0"/>
                                <TextBlock Text="Schema Browser"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Name="NavBulkEditor" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" Margin="0,0,8,0"/>
                                <TextBlock Text="Bulk Operations"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Group 3: SYSTEM -->
                        <Separator Background="#252936" Margin="12,8"/>
                        <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="14,4,14,4"/>

                        <RadioButton Name="NavConnections" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐" Margin="0,0,8,0"/>
                                <TextBlock Text="Connections"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Name="NavSettings" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" Margin="0,0,8,0"/>
                                <TextBlock Text="Settings"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- MAIN VIEWPORT CONTENT TABS -->
            <Grid Grid.Column="1" Background="#161821">

                <!-- 1. DASHBOARD PANEL -->
                <Grid Name="PanelDashboard" Visibility="Visible" Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Active Directory Overview &amp; Health" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
