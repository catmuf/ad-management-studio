                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Name="BtnNewProfile" Style="{StaticResource PrimaryButton}" Content="➕ Add Profile" Margin="0,0,6,0"/>
                                <Button Name="BtnRunDiagFull" Style="{StaticResource ModernButton}" Content="🩺 Test Connection Diagnostics"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Diagnostics Card & Profile Manager -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Profiles List -->
                        <Border Grid.Column="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Configured Profiles" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ListBox Grid.Row="1" Name="ListProfiles" Background="#161820" BorderThickness="1" BorderBrush="#2F3446" Foreground="#FFFFFF"/>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Name="BtnDeleteProfile" Style="{StaticResource DangerButton}" Content="Delete Profile"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Live Diagnostic Results -->
                        <Border Grid.Column="1" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Server Diagnostics &amp; Health Report" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/>

                                <Border Background="#161820" BorderBrush="#2F3446" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Target Server:" Foreground="#9CA3AF"/>
                                            <TextBlock Name="TxtDiagServer" Text="--" HorizontalAlignment="Right" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="IP Address:" Foreground="#9CA3AF"/>
                                            <TextBlock Name="TxtDiagIp" Text="--" HorizontalAlignment="Right" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="LDAP TCP Port (389):" Foreground="#9CA3AF"/>
                                            <TextBlock Name="TxtDiagPortStatus" Text="--" HorizontalAlignment="Right" Foreground="#107C41" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Round-Trip Latency:" Foreground="#9CA3AF"/>
                                            <TextBlock Name="TxtDiagLatency" Text="--" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="RootDSE Default NC:" Foreground="#9CA3AF"/>
                                            <TextBlock Name="TxtDiagDefaultNC" Text="--" HorizontalAlignment="Right" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Name="TxtDiagMessage" Text="Ready." Foreground="#9CA3AF" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 15. SETTINGS PANEL -->
                <Grid Name="PanelSettings" Visibility="Collapsed" Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Application Settings &amp; Preferences" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Configure directory defaults, naming conventions, password policies, and CSV exports." FontSize="13" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="8" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                                <TextBlock Text="Active Directory Configuration" FontSize="15" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,12"/>

                                <CheckBox Name="ChkAutoDetect" Content="Auto-detect Active Directory domain and primary controller" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                                <TextBlock Text="Default SearchBase DN (optional override):" Margin="0,0,0,4"/>
                                <TextBox Name="TxtCfgSearchBase" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                                <Separator Background="#252936" Margin="0,10,0,14"/>
                                <TextBlock Text="User Provisioning Defaults" FontSize="15" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,12"/>

                                <TextBlock Text="Default Username Format:" Margin="0,0,0,4"/>
                                <ComboBox Name="CmbUsernameFormat" Style="{StaticResource ModernComboBox}" Margin="0,0,0,12">
                                    <ComboBoxItem Content="first.last (e.g. john.doe)" IsSelected="True"/>
                                    <ComboBoxItem Content="flast (e.g. jdoe)"/>
                                    <ComboBoxItem Content="firstl (e.g. johnd)"/>
                                    <ComboBoxItem Content="lastf (e.g. doej)"/>
                                </ComboBox>

                                <TextBlock Text="Generated Password Length:" Margin="0,0,0,4"/>
                                <TextBox Name="TxtCfgPasswordLength" Style="{StaticResource ModernTextBox}" Text="16" Margin="0,0,0,12"/>

                                <CheckBox Name="ChkCfgRequirePwChange" Content="Require password change at next logon by default" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,0,14"/>

                                <Separator Background="#252936" Margin="0,10,0,14"/>
                                <TextBlock Text="Export Preferences" FontSize="15" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,12"/>

                                <TextBlock Text="CSV Delimiter:" Margin="0,0,0,4"/>
                                <ComboBox Name="CmbExportDelimiter" Style="{StaticResource ModernComboBox}" Margin="0,0,0,16">
                                    <ComboBoxItem Content="; (Semicolon - Recommended for Excel Europe)" IsSelected="True"/>
                                    <ComboBoxItem Content=", (Comma - Standard CSV)"/>
                                </ComboBox>

                                <Button Name="BtnSaveSettings" Style="{StaticResource PrimaryButton}" Content="💾 Save Settings" Width="140" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#0F1015" BorderBrush="#252936" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Name="TxtStatusMessage" Text="Ready: Active Directory Management Studio initialized." FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Name="TxtScopeMessage" Text="Connected to Active Directory" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
