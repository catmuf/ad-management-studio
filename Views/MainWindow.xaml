<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Active Directory Management Studio"
    Height="820" Width="1240"
    MinHeight="650" MinWidth="950"
    WindowStartupLocation="CenterScreen"
    Background="#18191D"
    Foreground="#F3F4F6"
    FontFamily="Segoe UI, Segoe UI Variable, Arial"
    FontSize="13">

    <Window.Resources>
        <!-- Modern Color Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#121316"/>
        <SolidColorBrush x:Key="BgSidebar" Color="#1A1C23"/>
        <SolidColorBrush x:Key="BgSurface" Color="#22252F"/>
        <SolidColorBrush x:Key="BgCard" Color="#2A2D3A"/>
        <SolidColorBrush x:Key="BgInput" Color="#1A1C23"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#373B4D"/>
        <SolidColorBrush x:Key="AccentPrimary" Color="#0078D4"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1084D9"/>
        <SolidColorBrush x:Key="AccentActive" Color="#006CBE"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#107C41"/>
        <SolidColorBrush x:Key="DangerColor" Color="#D13438"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="InfoColor" Color="#0EA5E9"/>

        <!-- Standard Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2D3A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#373B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#373B4D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4F5468"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22252F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1084D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#006CBE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#3A1C20"/>
            <Setter Property="BorderBrush" Value="#D13438"/>
            <Setter Property="Foreground" Value="#FFA3A8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D13438"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Input TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1C23"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#373B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1C23"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#373B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Nav RadioButton Style (Sidebar Tabs) -->
        <Style x:Key="NavTabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Name="navBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,0" Margin="8,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Name="navIndicator" Text="▌" Foreground="Transparent" Margin="0,0,8,0" FontSize="11" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#22252F"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#2A2D3A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="navIndicator" Property="Foreground" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#1A1C23"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#373B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#1A1C23"/>
            <Setter Property="AlternatingRowBackground" Value="#20232B"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2D313F"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>

        <!-- Modern DataGrid ColumnHeader -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2A2D3A"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#373B4D"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- Modern DataGrid Row -->
        <Style TargetType="DataGridRow">
            <Setter Property="Padding" Value="4,0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#004C87"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern DataGrid Cell -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/> <!-- Top Header -->
            <RowDefinition Height="*"/>  <!-- Main Body (Sidebar + Content) -->
            <RowDefinition Height="30"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Background="#16181F" BorderBrush="#2D313F" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="#0078D4" CornerRadius="6" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Active Directory Studio" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                        <TextBlock Text="Windows Server Management Suite" FontSize="11" Foreground="#9CA3AF"/>
                    </StackPanel>
                </StackPanel>

                <!-- Connection Indicator Badge -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#22252F" BorderBrush="#373B4D" BorderThickness="1" CornerRadius="16" Padding="14,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Name="StatusDot" Width="8" Height="8" Fill="#107C41" Margin="0,0,8,0"/>
                        <TextBlock Name="TxtDomainBadge" Text="Connected: vielcahp.com" FontSize="12" FontWeight="SemiBold" Foreground="#E5E7EB"/>
                        <TextBlock Text=" | DC: " FontSize="12" Foreground="#9CA3AF"/>
                        <TextBlock Name="TxtDCBadge" Text="VS-DC-01.vielcahp.com" FontSize="12" Foreground="#9CA3AF"/>
                    </StackPanel>
                </Border>

                <!-- Top Quick Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="BtnGlobalRefresh" Style="{StaticResource ModernButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh All"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY: SIDEBAR + CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/> <!-- Left Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Main Viewport -->
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#16181F" BorderBrush="#2D313F" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <!-- Navigation Category Header -->
                    <TextBlock DockPanel.Dock="Top" Text="NAVIGATION" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="16,16,16,8"/>

                    <!-- Nav Items -->
                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton Name="NavDashboard" Style="{StaticResource NavTabButton}" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" Margin="0,0,10,0"/>
                                <TextBlock Text="Dashboard"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Name="NavUsers" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" Margin="0,0,10,0"/>
                                <TextBlock Text="Users"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Name="NavGroups" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡️" Margin="0,0,10,0"/>
                                <TextBlock Text="Groups"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Name="NavOUs" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" Margin="0,0,10,0"/>
                                <TextBlock Text="Org. Units (OUs)"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Bottom Nav Items -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                        <Separator Background="#2D313F" Margin="12,8"/>
                        <RadioButton Name="NavSettings" Style="{StaticResource NavTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" Margin="0,0,10,0"/>
                                <TextBlock Text="Settings"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Spacer -->
                    <Grid/>
                </DockPanel>
            </Border>

            <!-- MAIN VIEWPORT CONTENT TABS -->
            <Grid Grid.Column="1" Background="#1B1D24" Margin="0">

                <!-- 1. DASHBOARD PANEL -->
                <Grid Name="PanelDashboard" Visibility="Visible" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Subtitle -->
                        <RowDefinition Height="Auto"/> <!-- KPI Cards Grid -->
                        <RowDefinition Height="*"/>    <!-- Quick Operations & Recent -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Active Directory Overview" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Real-time health, statistics, and domain object metrics." FontSize="13" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- KPI Cards (6 Cards) -->
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,24">
                        <!-- Card 1: Total Users -->
                        <Border Background="#22252F" BorderBrush="#373B4D" BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="6">
                            <StackPanel>
                                <TextBlock Text="TOTAL USERS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                                <TextBlock Name="CardTotalUsers" Text="--" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,6,0,4"/>
                                <TextBlock Text="Registered in directory" FontSize="11" Foreground="#6B7280"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Active Users -->
                        <Border Background="#22252F" BorderBrush="#107C41" BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="6" Cursor="Hand" Name="CardBtnActiveUsers">
                            <StackPanel>
                                <TextBlock Text="ACTIVE USERS" FontSize="11" FontWeight="Bold" Foreground="#107C41"/>
                                <TextBlock Name="CardActiveUsers" Text="--" FontSize="28" FontWeight="Bold" Foreground="#107C41" Margin="0,6,0,4"/>
                                <TextBlock Text="Click to filter active accounts" FontSize="11" Foreground="#6B7280"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Disabled Users -->
                        <Border Background="#22252F" BorderBrush="#D13438" BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="6" Cursor="Hand" Name="CardBtnDisabledUsers">
                            <StackPanel>
                                <TextBlock Text="DISABLED USERS" FontSize="11" FontWeight="Bold" Foreground="#D13438"/>
                                <TextBlock Name="CardDisabledUsers" Text="--" FontSize="28" FontWeight="Bold" Foreground="#FFA3A8" Margin="0,6,0,4"/>
                                <TextBlock Text="Click to view disabled accounts" FontSize="11" Foreground="#6B7280"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Locked Accounts -->
                        <Border Background="#22252F" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="6" Cursor="Hand" Name="CardBtnLockedUsers">
                            <StackPanel>
                                <TextBlock Text="LOCKED OUT ACCOUNTS" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                                <TextBlock Name="CardLockedUsers" Text="--" FontSize="28" FontWeight="Bold" Foreground="#F59E0B" Margin="0,6,0,4"/>
                                <TextBlock Text="Click to view &amp; unlock accounts" FontSize="11" Foreground="#6B7280"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 5: Total Groups -->
                        <Border Background="#22252F" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="6" Cursor="Hand" Name="CardBtnGroups">
                            <StackPanel>
                                <TextBlock Text="TOTAL GROUPS" FontSize="11" FontWeight="Bold" Foreground="#0078D4"/>
                                <TextBlock Name="CardTotalGroups" Text="--" FontSize="28" FontWeight="Bold" Foreground="#60A5FA" Margin="0,6,0,4"/>
                                <TextBlock Text="Click to manage groups" FontSize="11" Foreground="#6B7280"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 6: Total OUs -->
                        <Border Background="#22252F" BorderBrush="#0EA5E9" BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="6" Cursor="Hand" Name="CardBtnOUs">
                            <StackPanel>
                                <TextBlock Text="ORGANIZATIONAL UNITS" FontSize="11" FontWeight="Bold" Foreground="#0EA5E9"/>
                                <TextBlock Name="CardTotalOUs" Text="--" FontSize="28" FontWeight="Bold" Foreground="#38BDF8" Margin="0,6,0,4"/>
                                <TextBlock Text="Click to explore OU hierarchy" FontSize="11" Foreground="#6B7280"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Quick Shortcuts / Actions Box -->
                    <Border Grid.Row="2" Background="#22252F" BorderBrush="#373B4D" BorderThickness="1" CornerRadius="8" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="QUICK ACTIONS" FontSize="12" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,14"/>
                            
                            <WrapPanel Grid.Row="1">
                                <Button Name="QuickBtnNewUser" Style="{StaticResource PrimaryButton}" Margin="0,0,12,12" Height="36">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕" Margin="0,0,6,0"/>
                                        <TextBlock Text="Create New User"/>
                                    </StackPanel>
                                </Button>

                                <Button Name="QuickBtnNewGroup" Style="{StaticResource ModernButton}" Margin="0,0,12,12" Height="36">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛡️" Margin="0,0,6,0"/>
                                        <TextBlock Text="Create New Group"/>
                                    </StackPanel>
                                </Button>

                                <Button Name="QuickBtnNewOU" Style="{StaticResource ModernButton}" Margin="0,0,12,12" Height="36">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" Margin="0,0,6,0"/>
                                        <TextBlock Text="Create New OU"/>
                                    </StackPanel>
                                </Button>

                                <Button Name="QuickBtnExportAll" Style="{StaticResource ModernButton}" Margin="0,0,12,12" Height="36">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📤" Margin="0,0,6,0"/>
                                        <TextBlock Text="Export Directory Report"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2. USERS PANEL -->
                <Grid Name="PanelUsers" Visibility="Collapsed" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search & Filters Toolbar -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons Toolbar -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Filter / Search Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Live Search Input -->
                        <TextBox Name="TxtUserSearch" Grid.Column="0" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,10,0"/>

                        <!-- Status Filter -->
                        <ComboBox Name="CmbUserStatus" Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="140" Height="34" Margin="0,0,10,0">
                            <ComboBoxItem Content="All Statuses" IsSelected="True"/>
                            <ComboBoxItem Content="Active Only"/>
                            <ComboBoxItem Content="Disabled Only"/>
                            <ComboBoxItem Content="Locked Only"/>
                        </ComboBox>

                        <!-- OU Scope Filter -->
                        <ComboBox Name="CmbUserOU" Grid.Column="2" Style="{StaticResource ModernComboBox}" Width="240" Height="34" Margin="0,0,10,0">
                            <ComboBoxItem Content="Entire Domain" IsSelected="True"/>
                        </ComboBox>

                        <!-- Search Button -->
                        <Button Name="BtnUserSearch" Grid.Column="3" Style="{StaticResource ModernButton}" Height="34" Width="80">
                            <TextBlock Text="Search"/>
                        </Button>
                    </Grid>

                    <!-- Action Ribbon -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="False">
                        <!-- Primary User Actions -->
                        <Button Name="BtnUserNew" Style="{StaticResource PrimaryButton}" Height="32" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" Margin="0,0,6,0"/>
                                <TextBlock Text="New User"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnUserEdit" Style="{StaticResource ModernButton}" Height="32" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✏️" Margin="0,0,6,0"/>
                                <TextBlock Text="Edit"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnUserView" Style="{StaticResource ModernButton}" Height="32" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👁️" Margin="0,0,6,0"/>
                                <TextBlock Text="Details"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnUserPassword" Style="{StaticResource ModernButton}" Height="32" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔑" Margin="0,0,6,0"/>
                                <TextBlock Text="Reset Password"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnUserToggleStatus" Style="{StaticResource ModernButton}" Height="32" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" Margin="0,0,6,0"/>
                                <TextBlock Text="Enable/Disable"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnUserUnlock" Style="{StaticResource ModernButton}" Height="32" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔓" Margin="0,0,6,0"/>
                                <TextBlock Text="Unlock"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnUserMove" Style="{StaticResource ModernButton}" Height="32" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂" Margin="0,0,6,0"/>
                                <TextBlock Text="Move OU"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnUserDelete" Style="{StaticResource DangerButton}" Height="32" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑️" Margin="0,0,6,0"/>
                                <TextBlock Text="Delete"/>
                            </StackPanel>
                        </Button>

                        <!-- Right Actions -->
                        <Button DockPanel.Dock="Right" Name="BtnUserExport" Style="{StaticResource ModernButton}" Height="32">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📤" Margin="0,0,6,0"/>
                                <TextBlock Text="Export CSV"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <!-- Users DataGrid -->
                    <DataGrid Name="GridUsers" Grid.Row="2" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <!-- Status Badge Column -->
                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusColor}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusBadge}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="160" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding SamAccountName}" Width="130"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Mail}" Width="160"/>
                            <DataGridTextColumn Header="Title / Cargo" Binding="{Binding Title}" Width="140"/>
                            <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="140"/>
                            <DataGridTextColumn Header="Office" Binding="{Binding Office}" Width="110"/>
                            <DataGridTextColumn Header="Employee ID" Binding="{Binding EmployeeID}" Width="90"/>
                            <DataGridTextColumn Header="OU Path" Binding="{Binding OUPath}" Width="180"/>
                            <DataGridTextColumn Header="Last Logon" Binding="{Binding LastLogonDate}" Width="120"/>
                        </DataGrid.Columns>

                        <!-- Context Menu -->
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="#22252F" Foreground="#FFFFFF" BorderBrush="#373B4D">
                                <MenuItem Name="CtxUserView" Header="👁️ View Details"/>
                                <MenuItem Name="CtxUserEdit" Header="✏️ Edit User"/>
                                <Separator Background="#373B4D"/>
                                <MenuItem Name="CtxUserPassword" Header="🔑 Reset Password"/>
                                <MenuItem Name="CtxUserUnlock" Header="🔓 Unlock Account"/>
                                <MenuItem Name="CtxUserToggle" Header="⚡ Enable / Disable"/>
                                <MenuItem Name="CtxUserMove" Header="📂 Move to Another OU"/>
                                <Separator Background="#373B4D"/>
                                <MenuItem Name="CtxUserCopyUser" Header="📋 Copy Username"/>
                                <Separator Background="#373B4D"/>
                                <MenuItem Name="CtxUserDelete" Header="🗑️ Delete User" Foreground="#FFA3A8"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>

                <!-- 3. GROUPS PANEL -->
                <Grid Name="PanelGroups" Visibility="Collapsed" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Filters -->
                        <RowDefinition Height="Auto"/> <!-- Action Ribbon -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Filter Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Name="TxtGroupSearch" Grid.Column="0" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,10,0"/>

                        <ComboBox Name="CmbGroupCategory" Grid.Column="1" Style="{StaticResource ModernComboBox}" Width="150" Height="34" Margin="0,0,10,0">
                            <ComboBoxItem Content="All Categories" IsSelected="True"/>
                            <ComboBoxItem Content="Security"/>
                            <ComboBoxItem Content="Distribution"/>
                        </ComboBox>

                        <ComboBox Name="CmbGroupScope" Grid.Column="2" Style="{StaticResource ModernComboBox}" Width="140" Height="34" Margin="0,0,10,0">
                            <ComboBoxItem Content="All Scopes" IsSelected="True"/>
                            <ComboBoxItem Content="Global"/>
                            <ComboBoxItem Content="Universal"/>
                            <ComboBoxItem Content="DomainLocal"/>
                        </ComboBox>

                        <Button Name="BtnGroupSearch" Grid.Column="3" Style="{StaticResource ModernButton}" Height="34" Width="80">
                            <TextBlock Text="Search"/>
                        </Button>
                    </Grid>

                    <!-- Action Ribbon -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="False">
                        <Button Name="BtnGroupNew" Style="{StaticResource PrimaryButton}" Height="32" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" Margin="0,0,6,0"/>
                                <TextBlock Text="New Group"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnGroupMembers" Style="{StaticResource ModernButton}" Height="32" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" Margin="0,0,6,0"/>
                                <TextBlock Text="Manage Members"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnGroupDelete" Style="{StaticResource DangerButton}" Height="32" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑️" Margin="0,0,6,0"/>
                                <TextBlock Text="Delete Group"/>
                            </StackPanel>
                        </Button>

                        <Button DockPanel.Dock="Right" Name="BtnGroupExport" Style="{StaticResource ModernButton}" Height="32">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📤" Margin="0,0,6,0"/>
                                <TextBlock Text="Export CSV"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <!-- Groups DataGrid -->
                    <DataGrid Name="GridGroups" Grid.Row="2" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Group Name" Binding="{Binding Name}" Width="220" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding GroupCategory}" Width="110"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding GroupScope}" Width="110"/>
                            <DataGridTextColumn Header="Members" Binding="{Binding MemberCount}" Width="80"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="250"/>
                            <DataGridTextColumn Header="OU Path" Binding="{Binding OUPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 4. ORGANIZATIONAL UNITS (OUs) PANEL -->
                <Grid Name="PanelOUs" Visibility="Collapsed" Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/> <!-- OU TreeView -->
                        <ColumnDefinition Width="*"/>   <!-- OU Details & Contents -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: OU Tree Explorer -->
                    <Border Grid.Column="0" Background="#22252F" BorderBrush="#373B4D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Title & Toolbar -->
                                <RowDefinition Height="*"/>    <!-- TreeView -->
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                                <TextBlock Text="DIRECTORY TREE" FontWeight="Bold" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Name="BtnOUNew" Style="{StaticResource PrimaryButton}" Height="28" Padding="8,2" Margin="0,0,4,0">
                                        <TextBlock Text="➕ New OU"/>
                                    </Button>
                                    <Button Name="BtnOURefresh" Style="{StaticResource ModernButton}" Height="28" Padding="8,2">
                                        <TextBlock Text="🔄"/>
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <!-- Modern Styled TreeView -->
                            <TreeView Name="TreeOUs" Grid.Row="1" Background="#1A1C23" Foreground="#FFFFFF" BorderBrush="#373B4D" BorderThickness="1">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2,4">
                                            <TextBlock Text="📁" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>

                    <!-- Right: Selected OU Inspector -->
                    <Border Grid.Column="1" Background="#22252F" BorderBrush="#373B4D" BorderThickness="1" CornerRadius="8" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Selected OU Header & Actions -->
                                <RowDefinition Height="Auto"/> <!-- Summary Bar -->
                                <RowDefinition Height="*"/>    <!-- Sub-contents TabControl -->
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Name="TxtOUDetailName" Text="Select an Organizational Unit" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Name="TxtOUDetailDN" Text="Click on any OU in the tree to browse its objects." FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Name="BtnOUDelete" Style="{StaticResource DangerButton}" Height="30" Margin="0,0,8,0">
                                        <TextBlock Text="🗑️ Delete OU"/>
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <!-- Summary info -->
                            <Border Grid.Row="1" Background="#1A1C23" BorderBrush="#373B4D" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Protection: " Foreground="#9CA3AF" FontWeight="SemiBold"/>
                                    <TextBlock Name="TxtOUProtection" Text="--" Foreground="#107C41" FontWeight="Bold" Margin="0,0,24,0"/>
                                    <TextBlock Text="Description: " Foreground="#9CA3AF" FontWeight="SemiBold"/>
                                    <TextBlock Name="TxtOUDescription" Text="--" Foreground="#FFFFFF"/>
                                </StackPanel>
                            </Border>

                            <!-- Members in OU DataGrid -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="USERS &amp; GROUPS IN THIS OU" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                                <DataGrid Name="GridOUObjects" Grid.Row="1" Style="{StaticResource ModernDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding ObjectClass}" Width="90"/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="Username / Sam" Binding="{Binding SamAccountName}" Width="160"/>
                                        <DataGridTextColumn Header="Distinguished Name" Binding="{Binding DistinguishedName}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 5. SETTINGS PANEL -->
                <Grid Name="PanelSettings" Visibility="Collapsed" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Application Settings" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Configure domain controller connection, default formats, and export preferences." FontSize="13" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#22252F" BorderBrush="#373B4D" BorderThickness="1" CornerRadius="8" Padding="24" MaxWidth="700" HorizontalAlignment="Left">
                        <StackPanel>
                            <!-- Domain Name -->
                            <TextBlock Text="Target Domain Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="SettingDomainName" Style="{StaticResource ModernTextBox}" Height="32" Margin="0,0,0,16"/>

                            <!-- Preferred Domain Controller -->
                            <TextBlock Text="Preferred Domain Controller (Optional / Leave blank for auto-discovery)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="SettingDC" Style="{StaticResource ModernTextBox}" Height="32" Margin="0,0,0,16"/>

                            <!-- Default Search Base -->
                            <TextBlock Text="Default Search Base / Root OU (Leave blank for whole domain)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="SettingSearchBase" Style="{StaticResource ModernTextBox}" Height="32" Margin="0,0,0,16"/>

                            <!-- Username Generation Format -->
                            <TextBlock Text="Default Username Suggestion Format" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox Name="SettingUsernameFormat" Style="{StaticResource ModernComboBox}" Height="32" Margin="0,0,0,16">
                                <ComboBoxItem Content="first.last (e.g. john.doe)" IsSelected="True"/>
                                <ComboBoxItem Content="flast (e.g. jdoe)"/>
                                <ComboBoxItem Content="firstl (e.g. johnd)"/>
                                <ComboBoxItem Content="lastf (e.g. doej)"/>
                            </ComboBox>

                            <!-- Password Default Length -->
                            <TextBlock Text="Default Generated Password Length" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="SettingPasswordLength" Style="{StaticResource ModernTextBox}" Height="32" Text="16" Margin="0,0,0,16"/>

                            <!-- Export Delimiter -->
                            <TextBlock Text="CSV Export Delimiter" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox Name="SettingDelimiter" Style="{StaticResource ModernComboBox}" Height="32" Margin="0,0,0,24">
                                <ComboBoxItem Content="; (Semicolon - Recommended for Excel in Europe)" IsSelected="True"/>
                                <ComboBoxItem Content=", (Comma - Standard CSV)"/>
                                <ComboBoxItem Content="Tab (\t)"/>
                            </ComboBox>

                            <!-- Save Settings Button -->
                            <Button Name="BtnSaveSettings" Style="{StaticResource PrimaryButton}" Height="36" Width="140" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" Margin="0,0,6,0"/>
                                    <TextBlock Text="Save Settings"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#121316" BorderBrush="#2D313F" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Name="TxtStatusBarMessage" Grid.Column="0" Text="Ready" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                <TextBlock Name="TxtStatusBarCounter" Grid.Column="1" Text="Loaded 0 objects" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
