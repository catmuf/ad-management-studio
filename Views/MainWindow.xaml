                        </Border>

                        <!-- Active Users Card -->
                        <Border Grid.Column="1" Name="CardBtnActiveUsers" Cursor="Hand" Background="#1E212D" BorderBrush="#2E3345" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="ACTIVE" FontSize="11" FontWeight="SemiBold" Foreground="#107C41"/>
                                <TextBlock Name="CardActiveUsers" Text="0" FontSize="26" FontWeight="Bold" Foreground="#107C41" Margin="0,4,0,0"/>
                                <TextBlock Text="Enabled accounts (click to view)" FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Disabled Users Card -->
                        <Border Grid.Column="2" Name="CardBtnDisabledUsers" Cursor="Hand" Background="#1E212D" BorderBrush="#2E3345" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="DISABLED" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444"/>
                                <TextBlock Name="CardDisabledUsers" Text="0" FontSize="26" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0"/>
                                <TextBlock Text="Inactive / Archived (click to view)" FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Locked Accounts Card -->
                        <Border Grid.Column="3" Name="CardBtnLockedUsers" Cursor="Hand" Background="#1E212D" BorderBrush="#2E3345" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="LOCKED OUT" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                <TextBlock Name="CardLockedUsers" Text="0" FontSize="26" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                                <TextBlock Text="Auth limit exceeded (click to view)" FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Groups Card -->
                        <Border Grid.Column="4" Name="CardBtnGroups" Cursor="Hand" Background="#1E212D" BorderBrush="#2E3345" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="GROUPS" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA"/>
                                <TextBlock Name="CardTotalGroups" Text="0" FontSize="26" FontWeight="Bold" Foreground="#60A5FA" Margin="0,4,0,0"/>
                                <TextBlock Text="Security &amp; Distribution (click to view)" FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- OUs Card -->
                        <Border Grid.Column="5" Name="CardBtnOUs" Cursor="Hand" Background="#1E212D" BorderBrush="#2E3345" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="ORG. UNITS" FontSize="11" FontWeight="SemiBold" Foreground="#A78BFA"/>
                                <TextBlock Name="CardTotalOUs" Text="0" FontSize="26" FontWeight="Bold" Foreground="#A78BFA" Margin="0,4,0,0"/>
                                <TextBlock Text="Containers in tree (click to view)" FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Quick Launchpads & Health Actions -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Quick Launch Suite -->
                        <Border Grid.Column="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="🚀 SysAdmin Quick Launchpad" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                                <Button Name="BtnDashSearch" Style="{StaticResource ModernButton}" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍 " FontSize="16"/>
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="Advanced Directory Search &amp; Filter Builder" FontWeight="Bold"/>
                                            <TextBlock Text="Execute custom LDAP filters, scopes, and paged directory queries." FontSize="11" Foreground="#9CA3AF"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <Button Name="BtnDashSql" Style="{StaticResource ModernButton}" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ " FontSize="16"/>
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="LDAP-SQL Query Console" FontWeight="Bold"/>
                                            <TextBlock Text="Query Active Directory objects using familiar SQL dialect." FontSize="11" Foreground="#9CA3AF"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <Button Name="BtnDashAttributes" Style="{StaticResource ModernButton}" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏷️ " FontSize="16"/>
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="Raw LDAP Attribute Editor" FontWeight="Bold"/>
                                            <TextBlock Text="Inspect and modify mandatory, optional, and operational attributes." FontSize="11" Foreground="#9CA3AF"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <Button Name="BtnDashAudits" Style="{StaticResource ModernButton}" HorizontalContentAlignment="Left" Padding="12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛡️ " FontSize="16"/>
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="Security &amp; Hygiene Auditing" FontWeight="Bold"/>
                                            <TextBlock Text="Audit inactive users, passwords never expire, empty groups, and unprotected OUs." FontSize="11" Foreground="#9CA3AF"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- System Environment Status -->
                        <Border Grid.Column="1" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="8" Padding="18" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🌐 Active Directory Environment" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Primary DC Emulator:" Foreground="#9CA3AF"/>
                                    <TextBlock Name="TxtDashPdc" Text="Detecting..." HorizontalAlignment="Right" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                </Grid>
                                <Separator Background="#252936" Margin="0,4,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Default Naming Context:" Foreground="#9CA3AF"/>
                                    <TextBlock Name="TxtDashDefaultNC" Text="Detecting..." HorizontalAlignment="Right" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="11"/>
                                </Grid>
                                <Separator Background="#252936" Margin="0,4,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Active Directory Module:" Foreground="#9CA3AF"/>
                                    <TextBlock Name="TxtDashModuleStatus" Text="Loaded" HorizontalAlignment="Right" Foreground="#107C41" FontWeight="SemiBold"/>
                                </Grid>
                                <Separator Background="#252936" Margin="0,4,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="LDAP Protocol Support:" Foreground="#9CA3AF"/>
                                    <TextBlock Text="LDAP v3 (RFC 4511) &amp; LDAPS" HorizontalAlignment="Right" Foreground="#60A5FA"/>
                                </Grid>
                                <Separator Background="#252936" Margin="0,4,0,14"/>

                                <Button Name="BtnDashTestConn" Style="{StaticResource ModernButton}" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🩺 "/>
                                        <TextBlock Text="Run Diagnostics"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 2. USERS PANEL -->
                <Grid Name="PanelUsers" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search & Filter Chips -->
                        <RowDefinition Height="Auto"/> <!-- Action Ribbon -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Name="TxtSearchUsers" Style="{StaticResource ModernTextBox}" Height="30" Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <RadioButton Name="FilterUserAll" Style="{StaticResource FilterChip}" Content="All" IsChecked="True"/>
                                <RadioButton Name="FilterUserActive" Style="{StaticResource FilterChip}" Content="Active"/>
                                <RadioButton Name="FilterUserDisabled" Style="{StaticResource FilterChip}" Content="Disabled"/>
                                <RadioButton Name="FilterUserLocked" Style="{StaticResource FilterChip}" Content="Locked"/>
                            </StackPanel>

                            <ComboBox Grid.Column="2" Name="CmbUserOUFilter" Style="{StaticResource ModernComboBox}" Height="30" Margin="0,0,10,0"/>

                            <Button Grid.Column="3" Name="BtnSearchUsers" Style="{StaticResource PrimaryButton}" Height="30" Content="Search"/>
                        </Grid>
                    </Border>

                    <!-- Action Ribbon -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Name="BtnNewUser" Style="{StaticResource PrimaryButton}" Content="➕ New User" Margin="0,0,6,0"/>
                        <Button Name="BtnEditUser" Style="{StaticResource ModernButton}" Content="✏️ Edit" Margin="0,0,6,0"/>
                        <Button Name="BtnViewUser" Style="{StaticResource ModernButton}" Content="👁️ Details" Margin="0,0,6,0"/>
                        <Button Name="BtnResetPassword" Style="{StaticResource ModernButton}" Content="🔑 Reset PW" Margin="0,0,6,0"/>
                        <Button Name="BtnToggleStatus" Style="{StaticResource ModernButton}" Content="⚡ Toggle Status" Margin="0,0,6,0"/>
                        <Button Name="BtnMoveUser" Style="{StaticResource ModernButton}" Content="📂 Move OU" Margin="0,0,6,0"/>
                        <Button Name="BtnUserRawAttributes" Style="{StaticResource ModernButton}" Content="🏷️ Raw Attributes" Margin="0,0,6,0"/>
                        <Button Name="BtnUserCompare" Style="{StaticResource ModernButton}" Content="⚖️ Compare" Margin="0,0,6,0"/>
                        <Button Name="BtnDeleteUser" Style="{StaticResource DangerButton}" Content="🗑️ Delete" Margin="0,0,6,0"/>
                        <Button Name="BtnExportUsers" Style="{StaticResource ModernButton}" Content="📤 Export CSV"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2" Name="GridUsers" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusBadge}" Width="90"/>
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="160"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding SamAccountName}" Width="120"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                            <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="140"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="140"/>
                            <DataGridTextColumn Header="OU Location" Binding="{Binding OUPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 3. GROUPS PANEL -->
                <Grid Name="PanelGroups" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Name="TxtSearchGroups" Style="{StaticResource ModernTextBox}" Height="30" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" Name="CmbGroupScopeFilter" Style="{StaticResource ModernComboBox}" Height="30" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="2" Name="CmbGroupCategoryFilter" Style="{StaticResource ModernComboBox}" Height="30" Margin="0,0,10,0"/>
                            <Button Grid.Column="3" Name="BtnSearchGroups" Style="{StaticResource PrimaryButton}" Height="30" Content="Search"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Name="BtnNewGroup" Style="{StaticResource PrimaryButton}" Content="➕ New Group" Margin="0,0,6,0"/>
                        <Button Name="BtnManageMembers" Style="{StaticResource ModernButton}" Content="👥 Manage Members" Margin="0,0,6,0"/>
                        <Button Name="BtnGroupRawAttributes" Style="{StaticResource ModernButton}" Content="🏷️ Raw Attributes" Margin="0,0,6,0"/>
                        <Button Name="BtnDeleteGroup" Style="{StaticResource DangerButton}" Content="🗑️ Delete Group" Margin="0,0,6,0"/>
                        <Button Name="BtnExportGroups" Style="{StaticResource ModernButton}" Content="📤 Export CSV"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" Name="GridGroups" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Group Name" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="SamAccountName" Binding="{Binding SamAccountName}" Width="160"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding GroupScope}" Width="110"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding GroupCategory}" Width="110"/>
                            <DataGridTextColumn Header="OU Location" Binding="{Binding OUPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 4. ORG. UNITS (OUs) PANEL -->
                <Grid Name="PanelOUs" Visibility="Collapsed" Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: OU Directory Tree -->
                    <Border Grid.Column="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Directory OU Hierarchy" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TreeView Grid.Row="1" Name="TreeOUs" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2,3">
                                            <TextBlock Text="📁 " FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E5E7EB" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Name="BtnNewOU" Style="{StaticResource PrimaryButton}" Content="➕ New OU" Margin="0,0,6,0"/>
                                <Button Name="BtnDeleteOU" Style="{StaticResource DangerButton}" Content="🗑️ Delete OU"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right: Selected OU Details & Objects -->
                    <Border Grid.Column="1" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- OU Inspector Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Name="TxtSelectedOUName" Text="Select an Organizational Unit" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Name="TxtSelectedOUDN" Text="" FontSize="11" Foreground="#9CA3AF" FontFamily="Consolas" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Contained Directory Objects:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border Background="#252A3A" CornerRadius="10" Padding="8,2" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Name="TxtSelectedOUObjectsCount" Text="0 objects" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="Scope:" VerticalAlignment="Center" Foreground="#9CA3AF" Margin="0,0,6,0"/>
                                <ComboBox Name="CmbOUSearchScope" Style="{StaticResource ModernComboBox}" Width="140" Height="28" Margin="0,0,10,0">
                                    <ComboBoxItem Content="OneLevel" IsSelected="True"/>
                                    <ComboBoxItem Content="Subtree"/>
                                </ComboBox>
                                <Button Name="BtnRefreshOUObjects" Style="{StaticResource ModernButton}" Height="28" Content="🔄 Refresh" Margin="0,0,8,0"/>
                                <Button Name="BtnOURawAttributes" Style="{StaticResource ModernButton}" Height="28" Content="🏷️ Raw Attributes" Margin="0,0,6,0"/>
                            </StackPanel>

                            <!-- Contained Objects DataGrid -->
                            <DataGrid Grid.Row="2" Name="GridOUObjects" Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding ObjectClass}" Width="80"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                                    <DataGridTextColumn Header="SamAccountName" Binding="{Binding SamAccountName}" Width="140"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                    <DataGridTextColumn Header="Distinguished Name" Binding="{Binding DistinguishedName}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 5. COMPUTERS PANEL -->
                <Grid Name="PanelComputers" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Name="TxtSearchComputers" Style="{StaticResource ModernTextBox}" Height="30" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Name="BtnSearchComputers" Style="{StaticResource PrimaryButton}" Height="30" Content="Search Computers"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Name="BtnComputerRawAttributes" Style="{StaticResource ModernButton}" Content="🏷️ Raw Attributes" Margin="0,0,6,0"/>
                        <Button Name="BtnComputerCompare" Style="{StaticResource ModernButton}" Content="⚖️ Compare" Margin="0,0,6,0"/>
                        <Button Name="BtnExportComputers" Style="{StaticResource ModernButton}" Content="📤 Export CSV"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" Name="GridComputers" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Computer Name" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="DNS Hostname" Binding="{Binding DNSHostName}" Width="190"/>
                            <DataGridTextColumn Header="Operating System" Binding="{Binding OperatingSystem}" Width="180"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding OSVersion}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Last Logon" Binding="{Binding LastLogon}" Width="140"/>
                            <DataGridTextColumn Header="OU Location" Binding="{Binding OUPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 6. DIRECTORY SEARCH PANEL (SOFTERRA FILTER BUILDER) -->
                <Grid Name="PanelDirectorySearch" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search Builder Bar -->
                        <RowDefinition Height="Auto"/> <!-- Execution & Export Action Ribbon -->
                        <RowDefinition Height="*"/>    <!-- Results DataGrid -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1D27" BorderBrush="#292E3E" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1: Search Base & Scope & Presets -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Search Base (DN):" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <TextBox Name="TxtSearchBaseDn" Style="{StaticResource ModernTextBox}" Height="28"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Scope:" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <ComboBox Name="CmbSearchScope" Style="{StaticResource ModernComboBox}" Height="28">
                                        <ComboBoxItem Content="Subtree" IsSelected="True"/>
                                        <ComboBoxItem Content="OneLevel"/>
                                        <ComboBoxItem Content="Base"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Search Presets:" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <ComboBox Name="CmbSearchPresets" Style="{StaticResource ModernComboBox}" Height="28">
                                        <ComboBoxItem Content="Custom Filter..." IsSelected="True"/>
                                        <ComboBoxItem Content="All Users"/>
                                        <ComboBoxItem Content="Locked Out Accounts"/>
                                        <ComboBoxItem Content="Disabled Accounts"/>
                                        <ComboBoxItem Content="Passwords Never Expire"/>
                                        <ComboBoxItem Content="Empty Groups"/>
                                        <ComboBoxItem Content="Privileged Accounts (adminCount=1)"/>
                                        <ComboBoxItem Content="Service Accounts (SPNs)"/>
                                        <ComboBoxItem Content="All Computers"/>
                                        <ComboBoxItem Content="Domain Controllers"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Live Attribute Search & Outcome Display -->
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBox Name="TxtSearchAttrFilter" Style="{StaticResource ModernTextBox}" Height="28"/>
                                    <TextBlock Name="TxtSearchAttrPlaceholder" Text="🔍 Quick filter attributes..." FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                </Grid>
                                <Button Grid.Column="1" Name="BtnClearAttrFilter" Style="{StaticResource ModernButton}" Height="28" Padding="10,2" Content="Clear" Margin="6,0,10,0"/>

                                <Border Grid.Column="2" Name="BorderSearchAttrOutcome" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
