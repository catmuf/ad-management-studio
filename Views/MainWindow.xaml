                                        <TextBlock Text="Target User:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Name="TxtGroupChangesUser" Style="{StaticResource ModernTextBox}" Width="220" Height="28" Tag="sAMAccountName (e.g. jdoe)" Margin="0,0,8,0"/>
                                        <Button Name="BtnScanGroupChanges" Style="{StaticResource PrimaryButton}" Height="28" Content="🔍 Scan Group Metadata" Margin="0,0,12,0"/>
                                        <TextBlock Text="Recovers historical additions and removals across all domain groups via msDS-ReplValueMetaData" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </Border>

                                <DataGrid Grid.Row="1" Name="GridGroupChanges" Style="{StaticResource ModernDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Status" Binding="{Binding StatusBadge}" Width="140"/>
                                        <DataGridTextColumn Header="Group Name" Binding="{Binding GroupName}" Width="220"/>
                                        <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="90"/>
                                        <DataGridTextColumn Header="Timestamp (UTC)" Binding="{Binding TimeUtc}" Width="160"/>
                                        <DataGridTextColumn Header="Originating DC" Binding="{Binding OriginatingDC}" Width="180"/>
                                        <DataGridTextColumn Header="Originating USN" Binding="{Binding OriginatingUSN}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 6: FINE-GRAINED PASSWORD POLICY (PSO) -->
                        <TabItem Header="🔑 Resultant PSO Policy">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Target User:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Name="TxtPsoUser" Style="{StaticResource ModernTextBox}" Width="220" Height="28" Tag="sAMAccountName (e.g. jdoe)" Margin="0,0,8,0"/>
                                        <Button Name="BtnEvalPso" Style="{StaticResource PrimaryButton}" Height="28" Content="⚡ Evaluate Resultant PSO" Margin="0,0,12,0"/>
                                        <TextBlock Text="Evaluates msDS-ResultantPSO and domain password policy precedence" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </Border>

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Effective Policy Source" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Name="TxtPsoResultPolicy" Text="Default Domain" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Min Password Length" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Name="TxtPsoMinLength" Text="8 Characters" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Lockout Threshold" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Name="TxtPsoLockout" Text="5 Attempts" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="PSO Precedence" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Name="TxtPsoResultPrecedence" Text="Normal" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Padding="12">
                                    <TextBlock Name="TxtPsoSummaryBadge" Text="Specify username and evaluate password policy rules." FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 7: LOCAL LOGON SESSIONS -->
                        <TabItem Header="🖥️ Local Logon Sessions">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Name="BtnQuerySessions" Style="{StaticResource PrimaryButton}" Height="28" Content="🔄 Query Active Sessions" Margin="0,0,12,0"/>
                                        <TextBlock Text="Enumerates console and RDP interactive sessions, session states, and idle times" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </Border>

                                <DataGrid Grid.Row="1" Name="GridSessions" Style="{StaticResource ModernDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="State" Binding="{Binding StatusBadge}" Width="100"/>
                                        <DataGridTextColumn Header="User Name" Binding="{Binding UserName}" Width="160"/>
                                        <DataGridTextColumn Header="Session ID" Binding="{Binding SessionId}" Width="80"/>
                                        <DataGridTextColumn Header="Session Name" Binding="{Binding SessionName}" Width="140"/>
                                        <DataGridTextColumn Header="Idle Time" Binding="{Binding IdleTime}" Width="100"/>
                                        <DataGridTextColumn Header="Logon Time" Binding="{Binding LogonTime}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- 23. NETWORK & SHARE DIAGNOSTICS SUITE (NETTOOLS PARITY) -->
                <Grid Name="PanelNetworkDiagnostics" Visibility="Collapsed" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📡 Network &amp; Share Diagnostics Suite" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="7-Step UNC Share Accessibility, SSL/TLS Certificate Chains with Revocation (0x80092013) &amp; DC Locator Port Scanner." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TabControl Grid.Row="1">
                        <!-- TAB 1: 7-STEP UNC SHARE TESTER -->
                        <TabItem Header="📁 7-Step UNC Share Checker">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Target UNC Path:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Name="TxtUncPathInput" Style="{StaticResource ModernTextBox}" Width="360" Height="28" Tag="e.g. \\dc01.corp.local\SYSVOL\corp.local" Margin="0,0,8,0"/>
                                        <Button Name="BtnRunUncTest" Style="{StaticResource PrimaryButton}" Height="28" Content="⚡ Run 7-Step Test" Margin="0,0,12,0"/>
                                        <TextBlock Text="Executes DNS ➔ Ping ➔ Port 135 ➔ SMB 445 ➔ Share ➔ Permissions ➔ Path" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </Border>

                                <DataGrid Grid.Row="1" Name="GridUncResults" Style="{StaticResource ModernDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Step" Binding="{Binding StepNumber}" Width="50"/>
                                        <DataGridTextColumn Header="Diagnostic Phase" Binding="{Binding StepName}" Width="160"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding StatusBadge}" Width="90"/>
                                        <DataGridTextColumn Header="Latency (ms)" Binding="{Binding LatencyMs}" Width="95"/>
                                        <DataGridTextColumn Header="Target / Endpoint" Binding="{Binding Target}" Width="200"/>
                                        <DataGridTextColumn Header="Diagnostic Output / Details" Binding="{Binding Details}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 2: CERTIFICATE & REVOCATION CHECKER -->
                        <TabItem Header="🔒 Website Certificate &amp; Revocation">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Target Host / URL:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Name="TxtCertUrlInput" Style="{StaticResource ModernTextBox}" Width="320" Height="28" Tag="e.g. https://adfs.corp.local or dc01:636" Margin="0,0,8,0"/>
                                        <Button Name="BtnCheckCert" Style="{StaticResource PrimaryButton}" Height="28" Content="🔍 Check Certificate" Margin="0,0,12,0"/>
                                        <TextBlock Text="Audits SSL/TLS expiry, Subject, SANs &amp; CRL/OCSP Revocation (0x80092013)" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </Border>

                                <DataGrid Grid.Row="1" Name="GridCertResults" Style="{StaticResource ModernDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Status" Binding="{Binding StatusBadge}" Width="90"/>
                                        <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="160"/>
                                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="160"/>
                                        <DataGridTextColumn Header="Issuer" Binding="{Binding Issuer}" Width="180"/>
                                        <DataGridTextColumn Header="Valid Until" Binding="{Binding ValidTo}" Width="110"/>
                                        <DataGridTextColumn Header="Days Left" Binding="{Binding DaysUntilExpiry}" Width="80"/>
                                        <DataGridTextColumn Header="Revocation Check" Binding="{Binding RevocationStatus}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 3: DC RESOLUTION & PORT SCANNER -->
                        <TabItem Header="📡 DC Resolution &amp; Port Profiles">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Target DC:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Name="TxtDcScanHost" Style="{StaticResource ModernTextBox}" Width="200" Height="28" Tag="e.g. DC01.corp.local" Margin="0,0,8,0"/>
                                        <TextBlock Text="Profile:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox Name="CmbDcScanProfile" Style="{StaticResource ModernComboBox}" Width="150" Height="28" Margin="0,0,8,0">
                                            <ComboBoxItem Content="StandardAD" IsSelected="True"/>
                                            <ComboBoxItem Content="FullAD"/>
                                            <ComboBoxItem Content="GlobalCatalog"/>
                                            <ComboBoxItem Content="Authentication"/>
                                        </ComboBox>
                                        <Button Name="BtnRunDcPortScan" Style="{StaticResource PrimaryButton}" Height="28" Content="⚡ Scan Ports" Margin="0,0,8,0"/>
                                        <Button Name="BtnSimulateDsGetDcName" Style="{StaticResource ModernButton}" Height="28" Content="🌐 DsGetDcName Simulator"/>
                                    </WrapPanel>
                                </Border>

                                <Border Grid.Row="1" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                                    <TextBlock Name="TxtDsGetDcNameSummary" Text="Ready: Scan standard Active Directory service ports (LDAP 389, Kerberos 88, GC 3268, SMB 445, DNS 53, RPC 135)." FontSize="11" Foreground="#38BDF8"/>
                                </Border>

                                <DataGrid Grid.Row="2" Name="GridDcPorts" Style="{StaticResource ModernDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Status" Binding="{Binding StatusBadge}" Width="110"/>
                                        <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="65"/>
                                        <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="130"/>
                                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80"/>
                                        <DataGridTextColumn Header="Latency (ms)" Binding="{Binding LatencyMs}" Width="95"/>
                                        <DataGridTextColumn Header="Description / Role" Binding="{Binding Description}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

            </Grid>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Name="TxtStatusMessage" Text="Ready: Active Directory Management Studio initialized." FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Name="TxtScopeMessage" Text="Connected to Active Directory" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
