<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Active Directory User"
    Height="660" Width="720"
    MinHeight="550" MinWidth="600"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource BgDark}"
    Foreground="{DynamicResource TextPrimary}"
    FontFamily="Segoe UI, Segoe UI Variable, Arial"
    FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#0F1015"/>
        <SolidColorBrush x:Key="BgSurface" Color="#1E212B"/>
        <SolidColorBrush x:Key="BgCard" Color="#252936"/>
        <SolidColorBrush x:Key="BgCardAlt" Color="#1A1D27"/>
        <SolidColorBrush x:Key="BgInput" Color="#181A22"/>
        <SolidColorBrush x:Key="InputBg" Color="#181A22"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#2F3446"/>
        <SolidColorBrush x:Key="AccentPrimary" Color="#0078D4"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1084D9"/>
        <SolidColorBrush x:Key="AccentActive" Color="#006CBE"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
        <SolidColorBrush x:Key="TextAccent" Color="#60A5FA"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#252936"/>
        <SolidColorBrush x:Key="ButtonHoverBg" Color="#323749"/>
        <SolidColorBrush x:Key="ButtonHoverBorder" Color="#4B526D"/>
        <SolidColorBrush x:Key="DropDownBg" Color="#181A22"/>
        <SolidColorBrush x:Key="DropDownBorderBrush" Color="#383E54"/>
        <SolidColorBrush x:Key="DropDownItemHoverBg" Color="#282D3E"/>
        <SolidColorBrush x:Key="DropDownItemHoverFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NavHoverBg" Color="#1E212B"/>
        <SolidColorBrush x:Key="NavSelectedBg" Color="#252936"/>
        <SolidColorBrush x:Key="DangerButtonBg" Color="#3A1C20"/>
        <SolidColorBrush x:Key="DangerButtonBorder" Color="#D13438"/>
        <SolidColorBrush x:Key="DangerButtonFg" Color="#FFA3A8"/>
        <SolidColorBrush x:Key="DangerColor" Color="#D13438"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#107C41"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="InfoColor" Color="#38BDF8"/>
        <SolidColorBrush x:Key="BadgeInfoBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="BadgeInfoBorder" Color="#334155"/>
        <SolidColorBrush x:Key="BadgeInfoFg" Color="#38BDF8"/>
        <SolidColorBrush x:Key="EditorRawFg" Color="#A7F3D0"/>
        <!-- Standard Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderBrushColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ComboBoxItem Dark Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderThickness="0" CornerRadius="3" Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource DropDownItemHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentPrimary}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border Name="ToggleBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Path Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource ButtonHoverBorder}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource TextPrimary}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource InfoColor}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.5"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource TextMuted}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern ComboBox (Dark Mode Aero Replacement) -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Focusable="False"
                                          ClickMode="Press"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            <Popup Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Name="DropDownBorder" Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource DropDownBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <VirtualizingStackPanel IsItemsHost="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default ComboBox Style (inherits from ModernComboBox) -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="tabBorder" Cursor="Hand" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource ButtonBg}"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Tabs -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,10" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Name="TxtDialogTitle" Text="Create New Active Directory User" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Name="TxtDialogSubtitle" Text="Enter account information, organizational details, and security policies." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋 Template Blueprint:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                    <ComboBox Name="CmbUserTemplate" Width="180" Height="30" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderBrushColor}">
                        <ComboBoxItem Content="Custom / Blank" IsSelected="True"/>
                        <ComboBoxItem Content="Standard Employee"/>
                        <ComboBoxItem Content="Contractor (Expires 90d)"/>
                        <ComboBoxItem Content="Domain Admin Template"/>
                        <ComboBoxItem Content="Service Account (No Expire)"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs Content -->
        <TabControl Grid.Row="1" Background="{DynamicResource ButtonBg}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Padding="16">
            <!-- 1. General Info -->
            <TabItem Header="👤 Profile" Style="{StaticResource ModernTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- First Name -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="First Name *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="TxtFirstName" Style="{StaticResource ModernTextBox}" Height="32"/>
                        </StackPanel>

                        <!-- Last Name -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="Last Name *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="TxtLastName" Style="{StaticResource ModernTextBox}" Height="32"/>
                        </StackPanel>

                        <!-- Display Name -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <TextBlock Text="Display Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="TxtDisplayName" Style="{StaticResource ModernTextBox}" Height="32"/>
                        </StackPanel>

                        <!-- Username (SamAccountName) -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="Username (SamAccountName) *" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Name="BtnSuggestUsername" DockPanel.Dock="Right" Style="{StaticResource ModernButton}" Padding="6,2" Height="22" FontSize="11" Margin="6,0,0,0">
                                    <TextBlock Text="Auto Suggest"/>
                                </Button>
                            </DockPanel>
                            <TextBox Name="TxtUsername" Style="{StaticResource ModernTextBox}" Height="32" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- UPN Suffix -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="User Principal Name (UPN) *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="TxtUPN" Style="{StaticResource ModernTextBox}" Height="32"/>
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="Email Address" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="TxtEmail" Style="{StaticResource ModernTextBox}" Height="32"/>
                        </StackPanel>

                        <!-- Employee ID / DNI / NIE -->
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="Employee ID / DNI" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="TxtEmployeeID" Style="{StaticResource ModernTextBox}" Height="32"/>
                        </StackPanel>

                        <!-- Description -->
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <TextBlock Text="Description / Notes" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="TxtDescription" Style="{StaticResource ModernTextBox}" Height="32"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 2. Organization -->
            <TabItem Header="🏢 Organization" Style="{StaticResource ModernTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Job Title -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="Job Title / Cargo" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="TxtJobTitle" Style="{StaticResource ModernTextBox}" Height="32"/>
                        </StackPanel>

                        <!-- Department -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="Department" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="TxtDepartment" Style="{StaticResource ModernTextBox}" Height="32"/>
                        </StackPanel>

                        <!-- Company -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="Company" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="TxtCompany" Style="{StaticResource ModernTextBox}" Height="32"/>
                        </StackPanel>

                        <!-- Office -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="Office Location" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="TxtOffice" Style="{StaticResource ModernTextBox}" Height="32"/>
                        </StackPanel>

                        <!-- Logon Script -->
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <TextBlock Text="Logon Script Path" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="TxtScriptPath" Style="{StaticResource ModernTextBox}" Height="32"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 3. Credentials & Security (for creation or editing) -->
            <TabItem Name="TabCredentials" Header="🔑 Password &amp; Status" Style="{StaticResource ModernTabItem}">
                <StackPanel Margin="4">
                    <!-- Password Row -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Account Password *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Name="TxtPassword" Style="{StaticResource ModernTextBox}" Height="32"/>
                        </StackPanel>
                        <Button Name="BtnGeneratePassword" Grid.Column="1" Style="{StaticResource ModernButton}" Height="32" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎲" Margin="0,0,6,0"/>
                                <TextBlock Text="Generate Strong Password"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="PASSWORD REQUIREMENTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBlock Text="• Minimum 12 characters" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="• Must contain uppercase, lowercase, numbers, and special symbols" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Account Options Checkboxes -->
                    <TextBlock Text="ACCOUNT POLICIES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,6"/>
                    <CheckBox Name="ChkMustChangePassword" Style="{StaticResource ModernCheckBox}" Content="User must change password at next logon" IsChecked="True"/>
                    <CheckBox Name="ChkPasswordNeverExpires" Style="{StaticResource ModernCheckBox}" Content="Password never expires"/>
                    <CheckBox Name="ChkAccountEnabled" Style="{StaticResource ModernCheckBox}" Content="Account is enabled" IsChecked="True"/>
                </StackPanel>
            </TabItem>

            <!-- 4. Target OU Location -->
            <TabItem Header="📁 Target OU" Style="{StaticResource ModernTabItem}">
                <StackPanel Margin="4">
                    <TextBlock Text="Select Organizational Unit (OU) *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox Name="CmbTargetOU" Style="{StaticResource ModernComboBox}" Height="34" Margin="0,0,0,16"/>

                    <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Padding="12">
                        <StackPanel>
                            <TextBlock Text="SELECTED OU DISTINGUISHED NAME:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBlock Name="TxtSelectedOUDN" Text="--" FontSize="11" Foreground="{DynamicResource AccentPrimary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Buttons -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock Name="TxtDialogError" VerticalAlignment="Center" Foreground="{DynamicResource DangerButtonFg}" FontSize="12" FontWeight="SemiBold"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Name="BtnCancel" Style="{StaticResource ModernButton}" Margin="0,0,10,0">
                    <TextBlock Text="Cancel"/>
                </Button>
                <Button Name="BtnSaveUser" Style="{StaticResource PrimaryButton}">
                    <TextBlock Text="Save User"/>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
