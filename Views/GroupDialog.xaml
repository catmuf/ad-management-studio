<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Active Directory Group"
    Height="540" Width="580"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="{DynamicResource BgDark}"
    Foreground="{DynamicResource TextPrimary}"
    FontFamily="Segoe UI, Segoe UI Variable, Arial"
    FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#0F1015"/>
        <SolidColorBrush x:Key="BgSurface" Color="#1E212B"/>
        <SolidColorBrush x:Key="BgCard" Color="#252936"/>
        <SolidColorBrush x:Key="BgCardAlt" Color="#1A1D27"/>
        <SolidColorBrush x:Key="BgInput" Color="#181A22"/>
        <SolidColorBrush x:Key="InputBg" Color="#181A22"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#2F3446"/>
        <SolidColorBrush x:Key="AccentPrimary" Color="#0078D4"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1084D9"/>
        <SolidColorBrush x:Key="AccentActive" Color="#006CBE"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
        <SolidColorBrush x:Key="TextAccent" Color="#60A5FA"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#252936"/>
        <SolidColorBrush x:Key="ButtonHoverBg" Color="#323749"/>
        <SolidColorBrush x:Key="ButtonHoverBorder" Color="#4B526D"/>
        <SolidColorBrush x:Key="DropDownBg" Color="#181A22"/>
        <SolidColorBrush x:Key="DropDownBorderBrush" Color="#383E54"/>
        <SolidColorBrush x:Key="DropDownItemHoverBg" Color="#282D3E"/>
        <SolidColorBrush x:Key="DropDownItemHoverFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NavHoverBg" Color="#1E212B"/>
        <SolidColorBrush x:Key="NavSelectedBg" Color="#252936"/>
        <SolidColorBrush x:Key="DangerButtonBg" Color="#3A1C20"/>
        <SolidColorBrush x:Key="DangerButtonBorder" Color="#D13438"/>
        <SolidColorBrush x:Key="DangerButtonFg" Color="#FFA3A8"/>
        <SolidColorBrush x:Key="DangerColor" Color="#D13438"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#107C41"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="InfoColor" Color="#38BDF8"/>
        <SolidColorBrush x:Key="BadgeInfoBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="BadgeInfoBorder" Color="#334155"/>
        <SolidColorBrush x:Key="BadgeInfoFg" Color="#38BDF8"/>
        <SolidColorBrush x:Key="EditorRawFg" Color="#A7F3D0"/>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderBrushColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,16,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Form Fields -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,10" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Name="TxtDialogTitle" Text="Create New Active Directory Group" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Configure group name, scope, category, and target location." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋 Template Blueprint:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                    <ComboBox Name="CmbGroupTemplate" Style="{StaticResource ModernComboBox}" Width="190" Height="30">
                        <ComboBoxItem Content="Custom / Blank" IsSelected="True"/>
                        <ComboBoxItem Content="Role Group (Global Security)"/>
                        <ComboBoxItem Content="Resource Group (Domain Local)"/>
                        <ComboBoxItem Content="Enterprise Group (Universal Security)"/>
                        <ComboBoxItem Content="Distribution List (Universal Mail)"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Group Name -->
                <TextBlock Text="Group Name *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Name="TxtGroupName" Style="{StaticResource ModernTextBox}" Height="32" Margin="0,0,0,12"/>

                <!-- SamAccountName -->
                <TextBlock Text="Group Name (Pre-Windows 2000 / SamAccountName) *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Name="TxtGroupSam" Style="{StaticResource ModernTextBox}" Height="32" Margin="0,0,0,12"/>

                <!-- Description -->
                <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Name="TxtGroupDescription" Style="{StaticResource ModernTextBox}" Height="32" Margin="0,0,0,14"/>

                <!-- Group Scope & Category in Card -->
                <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Scope -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="GROUP SCOPE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                            <RadioButton Name="RadScopeGlobal" GroupName="GroupScope" Style="{StaticResource ModernRadioButton}" Content="Global" IsChecked="True"/>
                            <RadioButton Name="RadScopeUniversal" GroupName="GroupScope" Style="{StaticResource ModernRadioButton}" Content="Universal"/>
                            <RadioButton Name="RadScopeDomainLocal" GroupName="GroupScope" Style="{StaticResource ModernRadioButton}" Content="Domain Local"/>
                        </StackPanel>

                        <!-- Category -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="GROUP TYPE / CATEGORY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                            <RadioButton Name="RadCatSecurity" GroupName="GroupCategory" Style="{StaticResource ModernRadioButton}" Content="Security" IsChecked="True"/>
                            <RadioButton Name="RadCatDistribution" GroupName="GroupCategory" Style="{StaticResource ModernRadioButton}" Content="Distribution"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Target OU -->
                <TextBlock Text="Target Organizational Unit (OU) *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox Name="CmbGroupOU" Style="{StaticResource ModernComboBox}" Height="34" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock Name="TxtDialogError" VerticalAlignment="Center" Foreground="{DynamicResource DangerButtonFg}" FontSize="12" FontWeight="SemiBold"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Name="BtnCancel" Style="{StaticResource ModernButton}" Margin="0,0,10,0">
                    <TextBlock Text="Cancel"/>
                </Button>
                <Button Name="BtnSaveGroup" Style="{StaticResource PrimaryButton}">
                    <TextBlock Text="Save Group"/>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
