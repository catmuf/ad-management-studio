<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Active Directory Group"
    Height="540" Width="580"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="#18191D"
    Foreground="#F3F4F6"
    FontFamily="Segoe UI, Segoe UI Variable, Arial"
    FontSize="13">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2D3A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#373B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#373B4D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1084D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1C23"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#373B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1C23"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#373B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,16,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Form Fields -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,10" BorderBrush="#2D313F" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Name="TxtDialogTitle" Text="Create New Active Directory Group" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="Configure group name, scope, category, and target location." FontSize="12" Foreground="#9CA3AF" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Group Name -->
                <TextBlock Text="Group Name *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Name="TxtGroupName" Style="{StaticResource ModernTextBox}" Height="32" Margin="0,0,0,12"/>

                <!-- SamAccountName -->
                <TextBlock Text="Group Name (Pre-Windows 2000 / SamAccountName) *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Name="TxtGroupSam" Style="{StaticResource ModernTextBox}" Height="32" Margin="0,0,0,12"/>

                <!-- Description -->
                <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Name="TxtGroupDescription" Style="{StaticResource ModernTextBox}" Height="32" Margin="0,0,0,14"/>

                <!-- Group Scope & Category in Card -->
                <Border Background="#22252F" BorderBrush="#373B4D" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Scope -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="GROUP SCOPE" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                            <RadioButton Name="RadScopeGlobal" GroupName="GroupScope" Style="{StaticResource ModernRadioButton}" Content="Global" IsChecked="True"/>
                            <RadioButton Name="RadScopeUniversal" GroupName="GroupScope" Style="{StaticResource ModernRadioButton}" Content="Universal"/>
                            <RadioButton Name="RadScopeDomainLocal" GroupName="GroupScope" Style="{StaticResource ModernRadioButton}" Content="Domain Local"/>
                        </StackPanel>

                        <!-- Category -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="GROUP TYPE / CATEGORY" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                            <RadioButton Name="RadCatSecurity" GroupName="GroupCategory" Style="{StaticResource ModernRadioButton}" Content="Security" IsChecked="True"/>
                            <RadioButton Name="RadCatDistribution" GroupName="GroupCategory" Style="{StaticResource ModernRadioButton}" Content="Distribution"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Target OU -->
                <TextBlock Text="Target Organizational Unit (OU) *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox Name="CmbGroupOU" Style="{StaticResource ModernComboBox}" Height="34" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock Name="TxtDialogError" VerticalAlignment="Center" Foreground="#FFA3A8" FontSize="12" FontWeight="SemiBold"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Name="BtnCancel" Style="{StaticResource ModernButton}" Margin="0,0,10,0">
                    <TextBlock Text="Cancel"/>
                </Button>
                <Button Name="BtnSaveGroup" Style="{StaticResource PrimaryButton}">
                    <TextBlock Text="Save Group"/>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
