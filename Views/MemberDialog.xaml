<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Group Membership Manager"
    Height="580" Width="720"
    MinHeight="460" MinWidth="580"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    Background="{DynamicResource BgDark}"
    Foreground="{DynamicResource TextPrimary}"
    FontFamily="Segoe UI, Segoe UI Variable, Arial"
    FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#0F1015"/>
        <SolidColorBrush x:Key="BgSurface" Color="#1E212B"/>
        <SolidColorBrush x:Key="BgCard" Color="#252936"/>
        <SolidColorBrush x:Key="BgCardAlt" Color="#1A1D27"/>
        <SolidColorBrush x:Key="BgInput" Color="#181A22"/>
        <SolidColorBrush x:Key="InputBg" Color="#181A22"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#2F3446"/>
        <SolidColorBrush x:Key="AccentPrimary" Color="#0078D4"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1084D9"/>
        <SolidColorBrush x:Key="AccentActive" Color="#006CBE"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
        <SolidColorBrush x:Key="TextAccent" Color="#60A5FA"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#252936"/>
        <SolidColorBrush x:Key="ButtonHoverBg" Color="#323749"/>
        <SolidColorBrush x:Key="ButtonHoverBorder" Color="#4B526D"/>
        <SolidColorBrush x:Key="DropDownBg" Color="#181A22"/>
        <SolidColorBrush x:Key="DropDownBorderBrush" Color="#383E54"/>
        <SolidColorBrush x:Key="DropDownItemHoverBg" Color="#282D3E"/>
        <SolidColorBrush x:Key="DropDownItemHoverFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NavHoverBg" Color="#1E212B"/>
        <SolidColorBrush x:Key="NavSelectedBg" Color="#252936"/>
        <SolidColorBrush x:Key="DangerButtonBg" Color="#3A1C20"/>
        <SolidColorBrush x:Key="DangerButtonBorder" Color="#D13438"/>
        <SolidColorBrush x:Key="DangerButtonFg" Color="#FFA3A8"/>
        <SolidColorBrush x:Key="DangerColor" Color="#D13438"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#107C41"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="InfoColor" Color="#38BDF8"/>
        <SolidColorBrush x:Key="BadgeInfoBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="BadgeInfoBorder" Color="#334155"/>
        <SolidColorBrush x:Key="BadgeInfoFg" Color="#38BDF8"/>
        <SolidColorBrush x:Key="EditorRawFg" Color="#A7F3D0"/>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderBrushColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonFg}"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernListBox" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Split: Add Member & Current Members -->
            <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,10" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Name="TxtDialogTitle" Text="Group Members" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Name="TxtGroupNameHeader" Text="Group: --" FontSize="13" Foreground="{DynamicResource AccentPrimary}" FontWeight="SemiBold" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Body: Two Columns (Left: Search & Add, Right: Current Members) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Find & Add Principals -->
            <Border Grid.Column="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search Box -->
                        <RowDefinition Height="*"/>    <!-- Results List -->
                        <RowDefinition Height="Auto"/> <!-- Add Button -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="ADD NEW MEMBER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,6,0">
                                <TextBox Name="TxtMemberSearch" Style="{StaticResource ModernTextBox}" Height="30" Padding="8,5,26,5" ToolTip="Search users by name, username, email, etc. Live search or press Enter."/>
                                <TextBlock Name="TxtMemberSearchPlaceholder" Text="🔍 Search users (name, logon...)" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="10,0,26,0" IsHitTestVisible="False"/>
                                <Button Name="BtnClearMemberSearch" Content="✕" Style="{StaticResource ModernButton}" Width="20" Height="20" Padding="0" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" ToolTip="Clear search filter"/>
                            </Grid>
                            <Button Name="BtnSearchMembers" Grid.Column="1" Style="{StaticResource ModernButton}" Height="30" Padding="12,2" ToolTip="Search directory">
                                <TextBlock Text="Search"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <ListBox Name="ListAvailableUsers" Grid.Row="1" Style="{StaticResource ModernListBox}" Margin="0,0,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                            <TextBlock Text="{Binding SamAccountName}" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontFamily="Consolas"/>
                                            <TextBlock Text=" • " Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                            <TextBlock Text="{Binding OUPath}" Foreground="{DynamicResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource BadgeInfoBg}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding StatusBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Name="BtnAddMember" Grid.Row="2" Style="{StaticResource PrimaryButton}" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕ Add to Group"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Right Pane: Current Members -->
            <Border Grid.Column="1" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Count -->
                        <RowDefinition Height="*"/>    <!-- Members List -->
                        <RowDefinition Height="Auto"/> <!-- Remove Button -->
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="MEMBERS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <RadioButton Name="RadDlgMembersDirect" Content="Direct" Foreground="{DynamicResource TextPrimary}" IsChecked="True" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <RadioButton Name="RadDlgMembersTransitive" Content="Transitive" Foreground="{DynamicResource InfoColor}" FontWeight="SemiBold" FontSize="10.5" VerticalAlignment="Center" ToolTip="Recursively expand nested group memberships"/>
                        </StackPanel>
                        <TextBlock Name="TxtMemberCount" DockPanel.Dock="Right" Text="0 members" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ListBox Name="ListCurrentMembers" Grid.Row="1" Style="{StaticResource ModernListBox}" Margin="0,0,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SamAccountName}" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontFamily="Consolas" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource BadgeInfoBg}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding ObjectClass}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextAccent}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Name="BtnRemoveMember" Grid.Row="2" Style="{StaticResource DangerButton}" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️ Remove Member"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Close Button -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock Name="TxtDialogStatus" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
            <Button DockPanel.Dock="Right" Name="BtnClose" Style="{StaticResource ModernButton}">
                <TextBlock Text="Done"/>
            </Button>
        </DockPanel>
    </Grid>
</Window>
