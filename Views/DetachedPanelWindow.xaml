<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Active Directory Management Studio"
        Width="1100" Height="750" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDark}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Mini Header & Docking Toolbar -->
            <RowDefinition Height="*"/>    <!-- Detached Panel Viewport Host -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP MINI DOCKING TOOLBAR -->
        <Border Grid.Row="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Name="TxtDetachedIcon" Text="📋" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Name="TxtDetachedTitle" Text="Tool Window" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Name="TxtDetachedCategory" Text="Detached Tool Window" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="BtnDockBack" Style="{DynamicResource ModernButton}" Height="26" Padding="10,2" ToolTip="Dock this tool back into the main application window (Ctrl+W)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x2B07;" Margin="0,0,5,0" FontWeight="Bold"/>
                            <TextBlock Text="Dock Back into Main Window" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DETACHED VIEWPORT CONTENT HOST -->
        <Grid Grid.Row="1" Name="DetachedContentHost" Background="{DynamicResource BgDark}">
            <!-- Dynamic panel element is mounted here during tear-off -->
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Name="TxtDetachedStatus" Text="Connected to Active Directory" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Name="TxtDetachedScope" Text="Multi-Window Active" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
